---
// observatory.astro — "The Observatory"
// Aladin Lite v3 survey atlas (the working real-sky camera).
// Free glide + click-to-identify on real telescope survey imagery (DSS/2MASS/etc.).
// The WWT/Explore lens was removed — it was not usable for directed viewing on this setup.
// Focus is on a clean, reliable Atlas experience with good object search and movement.
import Base from '../layouts/Base.astro';

// Single lens now: Atlas (Aladin). Explorer/WWT removed.
const LENS = { id: 'aladin', label: 'Atlas', icon: '🔭' };
---

<Base title="Atlas" description="Real sky — Aladin survey atlas. Free glide, click-to-identify, and wide sky views on real telescope survey imagery (DSS/2MASS/etc).">
  <section class="space-y-1">
    <div class="flex flex-col gap-0.5 mb-2">
      <a href={import.meta.env.BASE_URL} class="text-lg font-semibold tracking-tight text-mist-100 hover:text-signal-300 hover:no-underline" title="Back to console home">The Observatory</a>
      <p class="text-xs text-mist-400">
        Atlas — real sky. Zoom way out for the sky-globe view.
        <span class="text-mist-500">Planets &amp; Moon: live ephemeris (Miriade). Press <kbd class="text-mist-300">P</kbd> (or Pin) to save this view. Snapshot for PNG.</span>
      </p>
    </div>

    <!-- Single clean stage for Aladin (the working camera). No tabs. -->
    <div id="sky-stage" class="relative h-[68dvh] min-h-[420px] w-full overflow-hidden rounded-2xl border border-void-800 bg-black shadow-2xl">

      <!-- Aladin Lite v3 atlas — the primary real-sky camera now. -->
      <div id="aladin-lite-div" class="h-full w-full"></div>

      <!-- Survey toggle: deep zoomable color vs painted Milky Way.
           Bottom-center in normal view; in immersive we force-park it fixed near the
           viewport bottom (same root cause as #sky-controls) so it doesn't drift mid-field. -->
      <div id="survey-toggle" class="absolute bottom-3 left-1/2 z-[600] flex -translate-x-1/2 gap-1 rounded-full border border-white/10 bg-black/70 p-1 backdrop-blur">
        <button type="button" data-survey="P/DSS2/color" class="survey-btn rounded-full px-3 py-1 text-xs font-medium text-mist-300 transition-colors hover:text-mist-100">Deep Sky</button>
        <button type="button" data-survey="P/Mellinger/color" class="survey-btn rounded-full px-3 py-1 text-xs font-medium text-mist-300 transition-colors hover:text-mist-100">Milky Way</button>
      </div>

      <!-- Tiny live "now showing" chip - bottom-left to stay out of Aladin's top-right controls. -->
      <div id="now-chip" class="pointer-events-none absolute left-3 bottom-3 rounded-full border border-white/10 bg-black/60 px-3 py-1 text-xs text-mist-300 backdrop-blur">
        <span class="mr-1.5 inline-block h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
        <span id="now-showing">Atlas</span>
        <span class="ml-2 text-[10px] text-mist-500" id="atlas-build" title="Build stamp — if you don't see pinfix 10, the wrapper is serving old code">· pinfix 10</span>
      </div>

      <!-- Bottom-right control group: Snapshot + Wide.
           In Aladin immersive/full-screen we *move* these to a stable bottom-right spot (see JS)
           so they don't drift into the middle or cover native controls, but remain usable for
           watermarked snapshots. In normal view they sit bottom-right out of the way. -->
      <div id="sky-controls" class="absolute bottom-3 right-3 z-[700] flex items-center gap-2">
        <button
          id="sky-mystery"
          type="button"
          title="Jump to Mystery glow near Moon (Jul 9 typed coords)"
          aria-label="Fly to mystery glow coordinates"
          class="flex items-center gap-1.5 rounded-full border border-signal-400/40 bg-black/60 px-3 py-1 text-xs text-signal-300 backdrop-blur transition-colors hover:border-signal-400/70 hover:text-mist-100"
        >
          <span class="text-sm leading-none">✦</span>
          <span>Mystery</span>
        </button>
        <button
          id="sky-pin"
          type="button"
          title="Pin this view (or press P)"
          aria-label="Pin this sky view"
          class="flex items-center gap-1.5 rounded-full border border-white/10 bg-black/60 px-3 py-1 text-xs text-mist-300 backdrop-blur transition-colors hover:border-signal-400/50 hover:text-mist-100"
        >
          <span class="text-sm leading-none">📌</span>
          <span>Pin</span>
        </button>
        <button
          id="sky-snapshot"
          type="button"
          title="Save a snapshot of this view (PNG)"
          aria-label="Save a snapshot of this view"
          class="flex items-center gap-1.5 rounded-full border border-white/10 bg-black/60 px-3 py-1 text-xs text-mist-300 backdrop-blur transition-colors hover:border-signal-400/50 hover:text-mist-100"
        >
          <span class="text-sm leading-none">📸</span>
          <span>Snapshot</span>
        </button>
        <button
          id="wide-sky-btn"
          type="button"
          title="Wide sky / globe view (zoom way out)"
          class="flex items-center gap-1.5 rounded-full border border-white/10 bg-black/60 px-3 py-1 text-xs text-mist-300 backdrop-blur transition-colors hover:border-signal-400/50 hover:text-mist-100"
        >
          <span>🌐</span>
          <span>Wide</span>
        </button>
      </div>
    </div>

    <p class="text-xs text-mist-500">
      Atlas — Aladin Lite v3 (CDS). Real survey imagery. Click objects for info. Observation only.
    </p>
    <!-- Location handoff notes from the retired globe are no longer injected here.
         Pins and Sky Events now open the Observatory directly for free glide. -->
  </section>

  <!-- Give the immersive camera as much room as possible -->
  <style is:inline>
    main { padding-top: 2px; padding-bottom: 4px; }
  </style>

  <!-- When the stage is fullscreen, drop the box styling so the engine gets the entire viewport
       and its edge controls (Atlas snapshot menu, zoom, layers) have room — no left/right clipping. -->
  <style is:inline>
    #sky-stage:fullscreen { height: 100dvh; min-height: 0; border-radius: 0; border: 0; }
    #sky-stage:-webkit-full-screen { height: 100dvh; min-height: 0; border-radius: 0; border: 0; }
    /* In full screen the engines own the corners — hide our info chip so it doesn't cover their controls. */
    #sky-stage:fullscreen #now-chip,
    #sky-stage:-webkit-full-screen #now-chip { display: none; }

    /* True browser fullscreen on the stage: pin our camera chrome to the stage edges. */
    #sky-stage:fullscreen #sky-controls,
    #sky-stage:-webkit-full-screen #sky-controls {
      position: fixed !important;
      bottom: 12px !important;
      right: 12px !important;
      top: auto !important;
      left: auto !important;
      z-index: 2147483000 !important;
    }
    #sky-stage:fullscreen #survey-toggle,
    #sky-stage:-webkit-full-screen #survey-toggle {
      position: fixed !important;
      bottom: 14px !important;
      left: 50% !important;
      top: auto !important;
      right: auto !important;
      transform: translateX(-50%) !important;
      z-index: 2147483000 !important;
    }

    /* When Aladin does its own expand, we reparent these onto <body> — keep them pinned. */
    #sky-controls.dlo-fs-park {
      position: fixed !important;
      bottom: 12px !important;
      right: 12px !important;
      top: auto !important;
      left: auto !important;
      z-index: 2147483000 !important;
      opacity: 0.92 !important;
    }
    #survey-toggle.dlo-fs-park {
      position: fixed !important;
      bottom: 14px !important;
      left: 50% !important;
      top: auto !important;
      right: auto !important;
      transform: translateX(-50%) !important;
      z-index: 2147483000 !important;
      opacity: 0.92 !important;
    }
    #now-chip.dlo-fs-park { display: none !important; }
  </style>

  <!-- Aladin engine (external CDN) — keep inline so Astro doesn't try to bundle the global. -->
  <script is:inline src="https://aladin.cds.unistra.fr/AladinLite/api/v3/latest/aladin.js" charset="utf-8"></script>

  <script is:inline>
    (function () {
      // Atlas-only now. WWT/Explorer removed.
      const STORAGE_KEY = 'dlo-sky-lens';
      const nowShowing = document.getElementById('now-showing');
      const surveyBtns = Array.from(document.querySelectorAll('.survey-btn'));
      let aladinBooted = false;
      let currentSurvey = 'P/DSS2/color';

      // Mystery glow near Moon — seeded + button-forced (Jul 9 typed coords).
      // Not one-shot: Mystery button always re-flies so authority is obeyed.
      var MYSTERY_ID = 'mystery-moon-2026-07-09';
      var MYSTERY_RA = (2 + 47 / 60 + 52.13 / 3600) * 15; // 02 47 52.13 → ~41.967°
      var MYSTERY_DEC = 21 + 23 / 60 + 30.4 / 3600; // +21 23 30.4 → ~21.392°
      var MYSTERY_FOV = 0.5;
      var MYSTERY_COO = '02 47 52.13  +21 23 30.4';
      var MYSTERY_LABEL = 'Mystery glow near Moon · Jul 9';

      // Hi 42 — kept as a *favorite pin*, not the Atlas boot default (boot default caused Orion slingshots).
      var M42_PIN_ID = 'favorite-m42-orion-nebula';
      var M42_RA = 83.8221;
      var M42_DEC = -5.3911;
      var M42_FOV = 1.5;
      var M42_LABEL = 'M42 · Orion Nebula';
      var M42_COO = '05 35 17.3  -05 23 28';
      var LAST_VIEW_KEY = 'dlo-last-atlas-view';
      // Quiet boot field — north galactic pole-ish empty patch. NEVER Orion.
      var SAFE_BOOT_RA = 192.75;   // ~12h 51m
      var SAFE_BOOT_DEC = 27.13;   // +27°
      var SAFE_BOOT_FOV = 40;
      var SAFE_BOOT_TARGET = '12 51 00.0 +27 07 48'; // sexagesimal — Aladin parses this reliably
      var allowM42AsLastView = false; // only true after an intentional Hi 42 / M42 favorite fly

      function coordsNearM42(ra, dec) {
        if (!isFinite(ra) || !isFinite(dec)) return false;
        var dra = Math.abs((((ra - M42_RA) % 360) + 540) % 360 - 180);
        var ddec = Math.abs(dec - M42_DEC);
        return dra < 2.5 && ddec < 2.5;
      }

      function readLastAtlasView() {
        try {
          var raw = localStorage.getItem(LAST_VIEW_KEY);
          if (!raw) return null;
          var v = JSON.parse(raw);
          if (v && isFinite(Number(v.ra)) && isFinite(Number(v.dec))) {
            var ra = Number(v.ra);
            var dec = Number(v.dec);
            // Old Orion boot poisoned this key — ignore so we don't re-slingshot forever.
            if (coordsNearM42(ra, dec)) {
              try { localStorage.removeItem(LAST_VIEW_KEY); } catch (e) {}
              console.warn('[observatory] cleared Orion-poisoned last view', ra, dec);
              return null;
            }
            return { ra: ra, dec: dec, fov: Number(v.fov) };
          }
        } catch (e) {}
        return null;
      }

      function saveLastAtlasView(ra, dec, fov, opts) {
        try {
          if (!isFinite(ra) || !isFinite(dec)) return;
          opts = opts || {};
          // Do not re-poison last-view with Orion unless this was an intentional M42 favorite fly.
          if (coordsNearM42(ra, dec) && !opts.allowM42 && !allowM42AsLastView) {
            return;
          }
          localStorage.setItem(LAST_VIEW_KEY, JSON.stringify({
            ra: ra,
            dec: dec,
            fov: isFinite(fov) && fov > 0 ? fov : 18,
            at: new Date().toISOString(),
          }));
        } catch (e) {}
      }

      function readPinsArray() {
        var pins = [];
        try {
          var raw = localStorage.getItem('personalPins');
          if (raw && raw !== 'undefined' && raw !== 'null') {
            var parsed = JSON.parse(raw);
            if (Array.isArray(parsed)) pins = parsed.filter(Boolean);
            else if (parsed && typeof parsed === 'object') {
              pins = Object.values(parsed).filter(function (p) { return p && typeof p === 'object'; });
            }
          }
        } catch (e) { pins = []; }
        if (!pins.length) {
          try {
            var bak = localStorage.getItem('personalPins:backup');
            if (bak && bak !== 'undefined' && bak !== 'null') {
              var bp = JSON.parse(bak);
              if (Array.isArray(bp) && bp.length) {
                pins = bp.filter(Boolean);
                localStorage.setItem('personalPins', JSON.stringify(pins));
              }
            }
          } catch (e2) {}
        }
        return pins;
      }

      function writePinsArray(pins) {
        if (!Array.isArray(pins)) return;
        try {
          var prev = localStorage.getItem('personalPins');
          if (prev && prev !== '[]' && prev !== 'undefined' && prev !== 'null') {
            localStorage.setItem('personalPins:backup', prev);
          }
        } catch (e) {}
        localStorage.setItem('personalPins', JSON.stringify(pins));
      }

      function ensureMysteryGlowPin() {
        try {
          var note =
            'Typed coords while bloom was visible under the Moon. Likely DSS saturation (Simbad empty @ 60″). Screenshots archived. ' +
            MYSTERY_COO;
          var pins = readPinsArray();
          var already = pins.some(function (p) { return p && p.id === MYSTERY_ID; });
          if (!already) {
            pins.unshift({
              id: MYSTERY_ID,
              createdAt: new Date().toISOString(),
              label: MYSTERY_LABEL,
              note: note,
              source: 'observatory',
              ra: MYSTERY_RA,
              dec: MYSTERY_DEC,
              fov: MYSTERY_FOV,
              viewState: {
                lat: MYSTERY_DEC,
                lng: MYSTERY_RA,
                altitude: MYSTERY_FOV,
                ra: MYSTERY_RA,
                dec: MYSTERY_DEC,
                fov: MYSTERY_FOV,
                coo: MYSTERY_COO,
              },
              thumbnailData: '',
              recoveryMeta: {
                originalCoordinates: {
                  ra: MYSTERY_RA,
                  dec: MYSTERY_DEC,
                  fov: MYSTERY_FOV,
                  coo: MYSTERY_COO,
                  frame: 'ICRS',
                },
                description: 'Seeded from typed coords after bloom vanished (2026-07-09)',
              },
            });
            writePinsArray(pins);
          }
        } catch (e) {}
      }

      /** Hi 42 lives on the Favorites shelf — never as the silent Atlas boot target. */
      function ensureM42FavoritePin() {
        try {
          // Only seed once per browser unless user deleted the flag after removing the pin.
          if (localStorage.getItem('dlo-m42-favorite-seeded') === '1') {
            var pinsCheck = readPinsArray();
            var stillThere = pinsCheck.some(function (p) {
              return p && (p.id === M42_PIN_ID || (p.label && labelLooksLikeM42(p.label)));
            });
            if (stillThere) return;
            // Pin was removed — don't keep resurrecting it every Observatory load.
            return;
          }
          var pins = readPinsArray();
          var existing = pins.find(function (p) { return p && p.id === M42_PIN_ID; });
          if (existing) {
            if (!existing.favorite) {
              existing.favorite = true;
              writePinsArray(pins);
            }
            localStorage.setItem('dlo-m42-favorite-seeded', '1');
            return;
          }
          var legacy = pins.find(function (p) {
            if (!p || !p.label) return false;
            var s = String(p.label).toLowerCase();
            return /\bm\s*42\b/.test(s) || /\borion\s+nebula\b/.test(s) || /\bhi\s*42\b/.test(s);
          });
          if (legacy) {
            legacy.favorite = true;
            if (!isFinite(Number(legacy.ra))) legacy.ra = M42_RA;
            if (!isFinite(Number(legacy.dec))) legacy.dec = M42_DEC;
            writePinsArray(pins);
            localStorage.setItem('dlo-m42-favorite-seeded', '1');
            return;
          }
          pins.unshift({
            id: M42_PIN_ID,
            createdAt: new Date().toISOString(),
            label: M42_LABEL,
            note: 'Hi 42 — Hitchhiker nod. Kept as a favorite so Atlas no longer boots here (stops Orion slingshots). ' + M42_COO,
            source: 'observatory',
            favorite: true,
            ra: M42_RA,
            dec: M42_DEC,
            fov: M42_FOV,
            viewState: {
              lat: M42_DEC,
              lng: M42_RA,
              altitude: M42_FOV,
              ra: M42_RA,
              dec: M42_DEC,
              fov: M42_FOV,
              coo: M42_COO,
            },
            thumbnailData: '',
            recoveryMeta: {
              originalCoordinates: { ra: M42_RA, dec: M42_DEC, fov: M42_FOV, coo: M42_COO, frame: 'ICRS' },
              description: 'Favorite pin — was formerly the hardcoded Atlas boot default',
            },
          });
          writePinsArray(pins);
          localStorage.setItem('dlo-m42-favorite-seeded', '1');
        } catch (e) {}
      }

      function flyToMysteryGlow(attempt) {
        attempt = attempt || 0;
        var a = window.__aladin;
        if (!a || typeof a.gotoRaDec !== 'function') {
          if (attempt < 12) setTimeout(function () { flyToMysteryGlow(attempt + 1); }, 400);
          else console.warn('[observatory] mystery fly: Atlas never woke');
          return;
        }
        try {
          a.gotoRaDec(MYSTERY_RA, MYSTERY_DEC);
          placeSsoMarker(a, MYSTERY_RA, MYSTERY_DEC, MYSTERY_LABEL);
          setTimeout(function () {
            try { if (typeof a.setFov === 'function') a.setFov(MYSTERY_FOV); } catch (e) {}
          }, 200);
          if (nowShowing) nowShowing.textContent = MYSTERY_LABEL;
          saveLastAtlasView(MYSTERY_RA, MYSTERY_DEC, MYSTERY_FOV);
          console.log('[observatory] mystery glow locked', MYSTERY_COO);
        } catch (e) {
          console.warn('[observatory] mystery fly failed', e);
        }
      }

      ensureMysteryGlowPin();
      ensureM42FavoritePin();

      function bootAladin() {
        if (aladinBooted || typeof A === 'undefined') return;
        aladinBooted = true;
        A.init.then(function () {
          // NEVER boot on M42. Aladin's own default / bad target parse has been landing on Orion.
          // Force a safe field with gotoRaDec after init — do not trust the target: string alone.
          var last = readLastAtlasView();
          var bootFov = last && isFinite(last.fov) && last.fov > 0 ? last.fov : SAFE_BOOT_FOV;
          var bootRa = last ? last.ra : SAFE_BOOT_RA;
          var bootDec = last ? last.dec : SAFE_BOOT_DEC;
          if (coordsNearM42(bootRa, bootDec)) {
            bootRa = SAFE_BOOT_RA;
            bootDec = SAFE_BOOT_DEC;
            bootFov = SAFE_BOOT_FOV;
            try { localStorage.removeItem(LAST_VIEW_KEY); } catch (e) {}
          }
          window.__aladin = A.aladin('#aladin-lite-div', {
            survey: currentSurvey,
            fov: bootFov,
            target: SAFE_BOOT_TARGET, // placeholder only — immediately overridden below
            cooFrame: 'equatorial',
            projection: 'SIN',
            showReticle: true,
            showZoomControl: true,
            showFullscreenControl: true,
            showLayersControl: true,
            showGotoControl: true,
            showSimbadPointerControl: true,
          });
          try {
            if (typeof window.__aladin.gotoRaDec === 'function') {
              window.__aladin.gotoRaDec(bootRa, bootDec);
            }
            if (typeof window.__aladin.setFov === 'function') {
              window.__aladin.setFov(bootFov);
            }
          } catch (e) {}
          if (nowShowing) {
            nowShowing.textContent = last && !coordsNearM42(bootRa, bootDec) ? 'Atlas · last view' : 'Atlas';
          }
          // Kick Orion again if Aladin still drifted there before pin handoff.
          function kickOrionIfUnwanted() {
            try {
              if (allowM42AsLastView) return;
              if (localStorage.getItem('flyToPin')) return;
              var a = window.__aladin;
              if (!a || typeof a.getRaDec !== 'function') return;
              var rd = a.getRaDec();
              if (!rd || rd.length < 2) return;
              if (coordsNearM42(Number(rd[0]), Number(rd[1]))) {
                console.warn('[observatory] Orion still on the lease — kicking to safe field');
                if (typeof a.gotoRaDec === 'function') a.gotoRaDec(SAFE_BOOT_RA, SAFE_BOOT_DEC);
                if (typeof a.setFov === 'function') a.setFov(SAFE_BOOT_FOV);
                if (nowShowing) nowShowing.textContent = 'Atlas';
                try { localStorage.removeItem(LAST_VIEW_KEY); } catch (e) {}
              }
            } catch (e) {}
          }
          setTimeout(kickOrionIfUnwanted, 300);
          setTimeout(kickOrionIfUnwanted, 1200);
          setTimeout(kickOrionIfUnwanted, 2500);
          // Drive from console/Sky Events pin if one was chosen (with retries)
          setTimeout(() => applyFlyToPinIfAny(0), 700);
          // Persist wherever the eye rests (for next calm boot) — never auto-save Orion.
          setInterval(function () {
            try {
              var a = window.__aladin;
              if (!a || typeof a.getRaDec !== 'function') return;
              var rd = a.getRaDec();
              if (!rd || rd.length < 2) return;
              var fovArr = typeof a.getFov === 'function' ? a.getFov() : null;
              var f = fovArr && isFinite(fovArr[0]) ? Number(fovArr[0]) : NaN;
              saveLastAtlasView(Number(rd[0]), Number(rd[1]), f);
            } catch (e) {}
          }, 8000);
        });
      }

      function styleSurvey() {
        surveyBtns.forEach(function (b) {
          var on = b.dataset.survey === currentSurvey;
          b.classList.toggle('bg-signal-400/20', on);
          b.classList.toggle('text-mist-100', on);
        });
      }

      function setSurvey(id) {
        currentSurvey = id;
        styleSurvey();
        var a = window.__aladin;
        if (!a) return;
        try {
          if (typeof a.setBaseImageLayer === 'function' && typeof A !== 'undefined' && A.imageHiPS) {
            a.setBaseImageLayer(A.imageHiPS(id));
          } else if (typeof a.setImageSurvey === 'function') {
            a.setImageSurvey(id);
          }
        } catch (e) {
          if (typeof a.setImageSurvey === 'function') a.setImageSurvey(id);
        }
      }

      surveyBtns.forEach(function (b) {
        b.addEventListener('click', function () { setSurvey(b.dataset.survey); });
      });
      styleSurvey();

      const snapshotBtn = document.getElementById('sky-snapshot');
      if (snapshotBtn) {
        snapshotBtn.classList.add('flex');
        snapshotBtn.classList.remove('hidden');
      }

      // Drive Atlas from a pin chosen in the console / Sky Events.
      // Deep-sky names go through Sesame (gotoObject). Venus/Moon/planets do NOT resolve
      // in Sesame — Aladin silently fails. For those we fetch live RA/Dec from Miriade
      // (IMCCE ephemcc) and gotoRaDec + drop a marker so the spot is unmistakable.
      const SSO_NAME_MAP = {
        moon: 'Moon',
        'full moon': 'Moon',
        mercury: 'Mercury',
        venus: 'Venus',
        'venus-evening': 'Venus',
        mars: 'Mars',
        jupiter: 'Jupiter',
        saturn: 'Saturn',
        uranus: 'Uranus',
        neptune: 'Neptune',
      };

      function extractCatalogId(label) {
        const target = (label || '').trim();
        const catalog = target.match(/\b((?:HD|HR|HIP|NGC|IC|M|Messier)\s*\d+[a-z]?)\b/i);
        if (!catalog) return null;
        return catalog[1].replace(/\s+/g, ' ').replace(/^messier\s*/i, 'M').replace(/^m\s+/i, 'M');
      }

      function normalizePinTarget(label) {
        let target = (label || '').trim();
        // Prefer a clean catalog id if the pin label has extra words ("HD 23514 star cluster").
        const catalog = extractCatalogId(target);
        if (catalog) return catalog;
        target = target
          .replace(/full moon/i, 'Moon')
          .replace(/perseid/i, 'Perseids')
          .replace(/geminid/i, 'Geminids')
          .replace(/andromeda galaxy/i, 'Andromeda')
          .replace(/andromeda/i, 'Andromeda')
          .replace(/venus-evening/i, 'Venus')
          .replace(/\bvenus\b/i, 'Venus');
        // Do NOT rewrite bare "Orion" into the target from substrings inside other names.
        if (/^orion(\s+nebula)?$/i.test(target) || /^m\s*42\b/i.test(target)) {
          return 'M42';
        }
        // Strip decorative suffixes like "· Jul 9" / "· live sky"
        target = target.split('·')[0].trim();
        return target;
      }

      // Pins that still carry M42 coords under another label are treated as
      // leftovers from when Atlas booted on Orion (Hi 42 is a favorite now).
      function isNearM42(ra, dec) {
        if (!isFinite(ra) || !isFinite(dec)) return false;
        const dra = Math.abs((((ra - M42_RA) % 360) + 540) % 360 - 180);
        const ddec = Math.abs(dec - M42_DEC);
        return dra < 1.5 && ddec < 1.5;
      }
      function labelLooksLikeM42(label) {
        const s = String(label || '').trim().toLowerCase();
        if (!s) return false;
        return /\bm\s*42\b/.test(s) || /\borion\s+nebula\b/.test(s) || /^orion$/.test(s) || /\bhi\s*42\b/.test(s);
      }

      function resolveSolarSystemName(target) {
        const key = String(target || '').trim().toLowerCase();
        if (!key) return null;
        if (SSO_NAME_MAP[key]) return SSO_NAME_MAP[key];
        // Primary subject only — "Mystery glow near Moon" must NOT become live Moon.
        const m = key.match(/^(?:next\s+)?(?:full\s+)?(moon|mercury|venus|mars|jupiter|saturn|uranus|neptune)\b/);
        if (m) return SSO_NAME_MAP[m[1]] || (m[1].charAt(0).toUpperCase() + m[1].slice(1));
        if (/^venus-evening\b/.test(key)) return 'Venus';
        return null;
      }

      function parseSesameRaDec(text) {
        const m = String(text || '').match(/%J\s+([+-]?\d+(?:\.\d+)?)\s+([+-]?\d+(?:\.\d+)?)/);
        if (!m) return null;
        const ra = Number(m[1]);
        const dec = Number(m[2]);
        if (!isFinite(ra) || !isFinite(dec)) return null;
        return { ra: ra, dec: dec };
      }

      function resolveViaSesameHttp(target) {
        const url = 'https://cdsweb.u-strasbg.fr/cgi-bin/nph-sesame/-oI/A?' + encodeURIComponent(target);
        return fetch(url).then(function (r) {
          if (!r.ok) throw new Error('Sesame HTTP ' + r.status);
          return r.text();
        }).then(function (text) {
          const coords = parseSesameRaDec(text);
          if (!coords) throw new Error('Sesame parse miss for ' + target);
          return coords;
        });
      }

      /** Rewrite a saved pin's sky coords after a successful catalog resolve (heals M42 / wrong-field poison). */
      function healPinCoords(pinId, label, ra, dec, fov) {
        try {
          if (!isFinite(ra) || !isFinite(dec)) return;
          var raw = localStorage.getItem('personalPins');
          var pins = [];
          try {
            if (raw && raw !== 'undefined' && raw !== 'null') {
              var parsed = JSON.parse(raw);
              if (Array.isArray(parsed)) pins = parsed.filter(Boolean);
            }
          } catch (e) { return; }
          if (!pins.length) return;
          var changed = false;
          var f = isFinite(fov) && fov > 0 ? fov : NaN;
          pins = pins.map(function (p) {
            if (!p) return p;
            var match = (pinId && p.id === pinId) || (label && p.label === label);
            if (!match) return p;
            var next = Object.assign({}, p);
            next.ra = ra;
            next.dec = dec;
            if (isFinite(f)) next.fov = f;
            var cat = extractCatalogId(next.label || label);
            if (cat) next.coordsHealed = cat;
            next.viewState = Object.assign({}, next.viewState || {}, {
              lat: dec,
              lng: ra,
              ra: ra,
              dec: dec,
              altitude: isFinite(f) ? f : (next.viewState && next.viewState.altitude) || 2.5,
              fov: isFinite(f) ? f : (next.viewState && next.viewState.fov) || 2.5,
            });
            changed = true;
            return next;
          });
          if (changed) {
            try { localStorage.setItem('personalPins:backup', JSON.stringify(pins)); } catch (e) {}
            localStorage.setItem('personalPins', JSON.stringify(pins));
          }
        } catch (e) {}
      }

      function scrubM42PoisonedPinsLocal() {
        try {
          var raw = localStorage.getItem('personalPins');
          var pins = [];
          try {
            if (raw && raw !== 'undefined' && raw !== 'null') {
              var parsed = JSON.parse(raw);
              if (Array.isArray(parsed)) pins = parsed.filter(Boolean);
            }
          } catch (e) { return; }
          if (!pins.length) {
            // Attempt backup restore before giving up.
            try {
              var bak = localStorage.getItem('personalPins:backup');
              if (bak && bak !== 'undefined' && bak !== 'null') {
                var bp = JSON.parse(bak);
                if (Array.isArray(bp) && bp.length) {
                  localStorage.setItem('personalPins', JSON.stringify(bp));
                }
              }
            } catch (e2) {}
            return;
          }
          var changed = false;
          var cleaned = pins.map(function (pin) {
            if (!pin || labelLooksLikeM42(pin.label)) return pin;
            var ra = Number(pin.ra != null ? pin.ra : (pin.viewState && pin.viewState.ra));
            var dec = Number(pin.dec != null ? pin.dec : (pin.viewState && pin.viewState.dec));
            if (!isFinite(ra) || !isFinite(dec) || !isNearM42(ra, dec)) return pin;
            changed = true;
            var next = Object.assign({}, pin);
            delete next.ra;
            delete next.dec;
            delete next.fov;
            if (next.viewState && typeof next.viewState === 'object') {
              next.viewState = Object.assign({}, next.viewState);
              delete next.viewState.ra;
              delete next.viewState.dec;
              delete next.viewState.fov;
              if (isNearM42(Number(next.viewState.lng), Number(next.viewState.lat))) {
                delete next.viewState.lat;
                delete next.viewState.lng;
                delete next.viewState.altitude;
              }
            }
            return next;
          });
          if (changed) {
            try { localStorage.setItem('personalPins:backup', JSON.stringify(pins)); } catch (e) {}
            localStorage.setItem('personalPins', JSON.stringify(cleaned));
          }
        } catch (e) {}
      }
      scrubM42PoisonedPinsLocal();

      // "+10:10:09.8" hours → degrees; "+12:50:22.9" sexagesimal degrees → degrees
      function sexagesimalToDegrees(str, isHours) {
        const s = String(str || '').trim();
        const m = s.match(/^([+-]?)(\d+(?:\.\d+)?)(?::(\d+(?:\.\d+)?)(?::(\d+(?:\.\d+)?))?)?/);
        if (!m) return NaN;
        const sign = m[1] === '-' ? -1 : 1;
        const a = parseFloat(m[2]) || 0;
        const b = parseFloat(m[3]) || 0;
        const c = parseFloat(m[4]) || 0;
        const val = sign * (Math.abs(a) + b / 60 + c / 3600);
        return isHours ? val * 15 : val;
      }

      function ssoDesiredFov(name) {
        if (name === 'Venus') return { start: 35, mid: 35, final: 32 };
        if (name === 'Moon') return { start: 30, mid: 30, final: 28 };
        return { start: 40, mid: 35, final: 30 }; // other planets: start wider
      }

      function placeSsoMarker(a, raDeg, decDeg, name) {
        try {
          if (typeof A === 'undefined' || typeof A.catalog !== 'function' || typeof A.marker !== 'function') return;
          if (window.__ssoMarkerCat && typeof a.removeOverlay === 'function') {
            try { a.removeOverlay(window.__ssoMarkerCat); } catch (e) {}
          } else if (window.__ssoMarkerCat && typeof a.removeLayer === 'function') {
            try { a.removeLayer(window.__ssoMarkerCat); } catch (e) {}
          }
          const cat = A.catalog({ name: name + ' (now)', sourceSize: 18, color: '#f5c542' });
          const marker = A.marker(raDeg, decDeg, {
            popupTitle: name,
            popupDesc: 'Live sky position · Miriade ephemeris (now)',
          });
          cat.addSources([marker]);
          a.addCatalog(cat);
          window.__ssoMarkerCat = cat;
        } catch (e) {}
      }

      function applyFovSchedule(a, fov) {
        setTimeout(() => { try { if (typeof a.setFov === 'function') a.setFov(fov.start); } catch (e) {} }, 200);
        setTimeout(() => { try { if (typeof a.setFov === 'function') a.setFov(fov.mid); } catch (e) {} }, 450);
        setTimeout(() => { try { if (typeof a.setFov === 'function') a.setFov(fov.final); } catch (e) {} }, 800);
      }

      function flyToSolarSystem(a, ssoName) {
        const url = 'https://ssp.imcce.fr/webservices/miriade/api/ephemcc.php'
          + '?-name=' + encodeURIComponent('p:' + ssoName)
          + '&-ep=now&-mime=json&-tcoor=1';
        return fetch(url)
          .then(function (r) {
            if (!r.ok) throw new Error('Miriade HTTP ' + r.status);
            return r.json();
          })
          .then(function (json) {
            const row = json && json.data && json.data[0];
            if (!row || row.RA == null || row.DEC == null) throw new Error('Miriade empty');
            const raDeg = sexagesimalToDegrees(row.RA, true);
            const decDeg = sexagesimalToDegrees(row.DEC, false);
            if (!isFinite(raDeg) || !isFinite(decDeg)) throw new Error('bad RA/Dec');
            if (typeof a.gotoRaDec === 'function') a.gotoRaDec(raDeg, decDeg);
            else if (typeof a.gotoObject === 'function') a.gotoObject(raDeg + ' ' + decDeg);
            placeSsoMarker(a, raDeg, decDeg, ssoName);
            applyFovSchedule(a, ssoDesiredFov(ssoName));
            if (nowShowing) {
              nowShowing.textContent = ssoName + ' · live sky';
            }
            saveLastAtlasView(raDeg, decDeg, ssoDesiredFov(ssoName).final);
            return { raDeg: raDeg, decDeg: decDeg };
          });
      }

      function flyToDeepSky(a, target, opts) {
        opts = opts || {};
        const displayLabel = (opts.label || target || '').trim();
        const pinId = opts.pinId;
        const desiredFov = Number(opts.fov);
        const fovFinal = isFinite(desiredFov) && desiredFov > 0 ? Math.min(desiredFov, 8) : 2.5;

        function landAt(ra, dec) {
          try {
            if (typeof a.gotoRaDec === 'function') a.gotoRaDec(ra, dec);
            placeSsoMarker(a, ra, dec, displayLabel || target);
            setTimeout(function () {
              try { if (typeof a.setFov === 'function') a.setFov(fovFinal); } catch (e) {}
            }, 200);
            if (nowShowing) nowShowing.textContent = displayLabel || target;
            saveLastAtlasView(ra, dec, fovFinal);
            healPinCoords(pinId, displayLabel, ra, dec, fovFinal);
          } catch (e) {
            console.warn('[observatory] landAt failed', target, e);
          }
        }

        function httpFallback() {
          resolveViaSesameHttp(target).then(function (c) {
            console.log('[observatory] Sesame HTTP resolved', target, c.ra, c.dec);
            landAt(c.ra, c.dec);
          }).catch(function (err) {
            console.warn('[observatory] Sesame resolve failed for', target, err);
          });
        }

        try {
          a.gotoObject(target, {
            success: function () {
              try {
                var rd = typeof a.getRaDec === 'function' ? a.getRaDec() : null;
                if (rd && rd.length >= 2 && isFinite(Number(rd[0])) && isFinite(Number(rd[1]))) {
                  healPinCoords(pinId, displayLabel, Number(rd[0]), Number(rd[1]), fovFinal);
                  saveLastAtlasView(Number(rd[0]), Number(rd[1]), fovFinal);
                }
              } catch (e) {}
              setTimeout(function () {
                try { if (typeof a.setFov === 'function') a.setFov(fovFinal); } catch (e) {}
              }, 200);
              if (nowShowing) nowShowing.textContent = displayLabel || target;
            },
            error: function () {
              // Aladin's built-in Sesame missed — hit CDS directly (do not rely on any Orion boot).
              httpFallback();
            },
          });
        } catch (e) {
          httpFallback();
        }
      }

      function applyFlyToPinIfAny(attempt = 0) {
        try {
          const raw = localStorage.getItem('flyToPin');
          if (!raw) return;
          const data = JSON.parse(raw);
          if (!data) { localStorage.removeItem('flyToPin'); return; }

          const a = window.__aladin;
          if (!a || (typeof a.gotoObject !== 'function' && typeof a.gotoRaDec !== 'function')) {
            if (attempt < 8) setTimeout(() => applyFlyToPinIfAny(attempt + 1), 550);
            return;
          }

          // Coordinate pins (from Observatory P-key): prefer exact RA/Dec over label resolve.
          // Do NOT clear flyToPin until a jump path succeeds — clearing early caused Orion slingshots
          // when Aladin was present but goto still failed / raced the old M42 boot default.
          // Only trust explicit ra/dec (not lat/lng) — Sky Events still stores placeholder lat/lng.
          // Catalog-named pins (HD 23514, NGC …): NEVER trust stored camera coords — those are often
          // the old M42 boot default or whatever field was on screen when P was hit.
          const vs = data.viewState || {};
          let ra = Number(data.ra != null ? data.ra : vs.ra);
          let dec = Number(data.dec != null ? data.dec : vs.dec);
          const fov = Number(data.fov != null ? data.fov : (vs.fov != null ? vs.fov : vs.altitude));
          const label = (data.label || data.title || data.name || '').trim();
          const catalogId = extractCatalogId(label);
          const pinId = data.id;
          const earlyTarget = normalizePinTarget(label);
          const ssoName = resolveSolarSystemName(earlyTarget) || resolveSolarSystemName(label);

          // Moon / Venus / planets: ALWAYS live ephemeris. Never trust camera-snapshot
          // coords (those are often Orion from the old boot or a wide-field P).
          if (ssoName) {
            console.warn('[observatory] SSO pin — Miriade only, ignoring stored coords', ssoName, ra, dec);
            localStorage.removeItem('flyToPin');
            if (nowShowing) nowShowing.textContent = ssoName + ' · finding…';
            flyToSolarSystem(a, ssoName).catch(function (err) {
              console.warn('[observatory] SSO fly-to failed', ssoName, err);
              if (nowShowing) nowShowing.textContent = ssoName + ' · ephemeris missed';
            });
            return;
          }

          // Authority pins: always use known coords (never Sesame / never poisoned snapshots).
          if (pinId === MYSTERY_ID || /mystery glow near moon/i.test(label)) {
            ra = MYSTERY_RA;
            dec = MYSTERY_DEC;
          } else if (pinId === M42_PIN_ID || labelLooksLikeM42(label)) {
            ra = M42_RA;
            dec = M42_DEC;
            allowM42AsLastView = true; // intentional Hi 42 visit may become last view
          }

          if (catalogId && !labelLooksLikeM42(label) && pinId !== MYSTERY_ID) {
            console.warn('[observatory] catalog pin — resolving by name, ignoring stored coords', catalogId, ra, dec);
            localStorage.removeItem('flyToPin');
            flyToDeepSky(a, catalogId, {
              label: label,
              pinId: pinId,
              fov: isFinite(fov) && fov > 0 ? fov : 2.5,
            });
            return;
          }

          if (isFinite(ra) && isFinite(dec) && isNearM42(ra, dec) && label && !labelLooksLikeM42(label) && pinId !== M42_PIN_ID) {
            console.warn('[observatory] ignoring M42-poisoned pin coords for label', label, ra, dec);
            ra = NaN;
            dec = NaN;
          }
          if (isFinite(ra) && isFinite(dec) && typeof a.gotoRaDec === 'function') {
            try {
              a.gotoRaDec(ra, dec);
              placeSsoMarker(a, ra, dec, (label || 'Pinned sky').trim());
              const f = isFinite(fov) && fov > 0 ? fov : (pinId === MYSTERY_ID ? MYSTERY_FOV : (pinId === M42_PIN_ID ? M42_FOV : 2));
              setTimeout(() => { try { if (typeof a.setFov === 'function') a.setFov(f); } catch (e) {} }, 200);
              if (nowShowing) nowShowing.textContent = (label || 'Pinned · live sky').trim();
              saveLastAtlasView(ra, dec, f, {
                allowM42: pinId === M42_PIN_ID || labelLooksLikeM42(label),
              });
              localStorage.removeItem('flyToPin');
              return;
            } catch (e) {
              if (attempt < 8) setTimeout(() => applyFlyToPinIfAny(attempt + 1), 550);
              return;
            }
          }

          if (!label) {
            localStorage.removeItem('flyToPin');
            return;
          }

          const target = normalizePinTarget(label);
          localStorage.removeItem('flyToPin');
          flyToDeepSky(a, target, { label: label, pinId: pinId, fov: fov });
        } catch (e) {}
      }

      // Boot Aladin immediately (only lens now)
      bootAladin();

      // Try pin handoff shortly after boot, plus a safety net
      setTimeout(() => applyFlyToPinIfAny(0), 900);
      setTimeout(() => applyFlyToPinIfAny(0), 2200);

      // --- Pin this Atlas view (P key / Pin button) ---------------------------------
      // Saves to the same localStorage.personalPins console My Pins reads. Stores
      // exact RA/Dec + FOV so mysterious unlabeled blooms can be revisited.
      function degToHms(raDeg) {
        var x = ((Number(raDeg) % 360) + 360) % 360 / 15;
        var h = Math.floor(x);
        var mFloat = (x - h) * 60;
        var m = Math.floor(mFloat);
        var s = (mFloat - m) * 60;
        return String(h).padStart(2, '0') + ' ' + String(m).padStart(2, '0') + ' ' + s.toFixed(2).padStart(5, '0');
      }
      function degToDms(decDeg) {
        var sign = Number(decDeg) < 0 ? '-' : '+';
        var x = Math.abs(Number(decDeg));
        var d = Math.floor(x);
        var mFloat = (x - d) * 60;
        var m = Math.floor(mFloat);
        var s = (mFloat - m) * 60;
        return sign + String(d).padStart(2, '0') + ' ' + String(m).padStart(2, '0') + ' ' + s.toFixed(1).padStart(4, '0');
      }

      function toastPin(msg, ok) {
        var toast = document.createElement('div');
        toast.style.cssText = 'position:fixed;bottom:28px;left:50%;transform:translateX(-50%);z-index:2000;background:#0f1420;border:1px solid ' + (ok ? '#36415a' : '#5c3a3a') + ';color:#e9edf5;padding:10px 20px;border-radius:9999px;font-size:13px;';
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function () { toast.remove(); }, 2800);
      }

      function captureObservatoryPin() {
        var a = window.__aladin;
        if (!a || typeof a.getRaDec !== 'function') {
          toastPin('Atlas is still waking up — try again in a moment', false);
          return;
        }
        var radec = a.getRaDec();
        if (!radec || radec.length < 2) {
          toastPin('Could not read sky position', false);
          return;
        }
        var ra = Number(radec[0]);
        var dec = Number(radec[1]);
        var fovArr = typeof a.getFov === 'function' ? a.getFov() : null;
        var fov = fovArr && isFinite(fovArr[0]) ? Number(fovArr[0]) : 2;
        var coordStr = degToHms(ra) + '  ' + degToDms(dec);

        var defaultLabel = (nowShowing && nowShowing.textContent && nowShowing.textContent.trim() && nowShowing.textContent.trim() !== 'Atlas')
          ? nowShowing.textContent.trim()
          : ('Atlas · ' + coordStr);

        var label = window.prompt('Name this pin', defaultLabel);
        if (label === null) return; // cancelled
        label = String(label).trim() || defaultLabel;
        var note = window.prompt('Optional note (coords kept either way)', coordStr);
        if (note === null) note = coordStr;
        note = String(note).trim() || coordStr;

        // Shrink Aladin capture to a small JPEG so localStorage can hold many pin thumbs.
        function shrinkPinThumb(dataUrl) {
          return new Promise(function (resolve) {
            if (typeof dataUrl !== 'string' || dataUrl.indexOf('data:image/') !== 0) {
              resolve('');
              return;
            }
            var img = new Image();
            img.onload = function () {
              try {
                var maxW = 320;
                var maxH = 200;
                var scale = Math.min(maxW / img.naturalWidth, maxH / img.naturalHeight, 1);
                var w = Math.max(1, Math.round(img.naturalWidth * scale));
                var h = Math.max(1, Math.round(img.naturalHeight * scale));
                var cv = document.createElement('canvas');
                cv.width = w;
                cv.height = h;
                var cx = cv.getContext('2d');
                if (!cx) { resolve(''); return; }
                cx.drawImage(img, 0, 0, w, h);
                resolve(cv.toDataURL('image/jpeg', 0.72));
              } catch (e) {
                resolve('');
              }
            };
            img.onerror = function () { resolve(''); };
            img.src = dataUrl;
          });
        }

        function savePinWithThumb(thumb) {
          var pin = {
            id: Date.now().toString(36) + Math.random().toString(36).slice(2, 7),
            createdAt: new Date().toISOString(),
            label: label,
            note: note,
            source: 'observatory',
            // Exact sky coords for Atlas re-entry (applyFlyToPinIfAny prefers these)
            ra: ra,
            dec: dec,
            fov: fov,
            // Console cards still expect viewState; map ra→lng, dec→lat, fov→altitude
            viewState: {
              lat: dec,
              lng: ra,
              altitude: fov,
              ra: ra,
              dec: dec,
              fov: fov,
              coo: coordStr,
            },
            thumbnailData: (typeof thumb === 'string' && thumb.indexOf('data:image/') === 0) ? thumb : '',
            recoveryMeta: {
              originalCoordinates: { ra: ra, dec: dec, fov: fov, coo: coordStr, frame: 'ICRS' },
              description: 'Pinned from Observatory Atlas camera',
            },
          };

          try {
            var pins = [];
            try {
              var rawPins = localStorage.getItem('personalPins');
              if (rawPins && rawPins !== 'undefined' && rawPins !== 'null') {
                var parsedPins = JSON.parse(rawPins);
                if (Array.isArray(parsedPins)) pins = parsedPins.filter(Boolean);
                else if (parsedPins && typeof parsedPins === 'object') {
                  pins = Object.values(parsedPins).filter(function (p) { return p && typeof p === 'object'; });
                }
              }
            } catch (eParse) { pins = []; }
            if (!pins.length) {
              try {
                var bakPins = localStorage.getItem('personalPins:backup');
                if (bakPins) {
                  var bpins = JSON.parse(bakPins);
                  if (Array.isArray(bpins) && bpins.length) pins = bpins.filter(Boolean);
                }
              } catch (eBak) {}
            }
            try {
              if (pins.length) localStorage.setItem('personalPins:backup', JSON.stringify(pins));
            } catch (eBak2) {}
            pins.unshift(pin);
            try {
              localStorage.setItem('personalPins', JSON.stringify(pins));
            } catch (quotaErr) {
              // Quota: drop the thumb and retry once so the pin itself still lands.
              pin.thumbnailData = '';
              pins[0] = pin;
              localStorage.setItem('personalPins', JSON.stringify(pins));
            }
            toastPin('Pinned · ' + label, true);
            if (nowShowing) nowShowing.textContent = label;
          } catch (e) {
            toastPin('Pin did not save', false);
          }
        }

        function finishPinCapture(rawUrl) {
          shrinkPinThumb(rawUrl).then(function (small) {
            savePinWithThumb(small || '');
          });
        }

        try {
          if (typeof a.getViewDataURL === 'function') {
            var res = a.getViewDataURL({ format: 'image/jpeg' });
            if (res && typeof res.then === 'function') {
              res.then(function (u) { finishPinCapture(u); }).catch(function () { savePinWithThumb(''); });
              return;
            }
            if (typeof res === 'string') { finishPinCapture(res); return; }
          }
        } catch (e) {}
        savePinWithThumb('');
      }

      var pinBtn = document.getElementById('sky-pin');
      if (pinBtn) pinBtn.addEventListener('click', captureObservatoryPin);

      var mysteryBtn = document.getElementById('sky-mystery');
      if (mysteryBtn) {
        mysteryBtn.addEventListener('click', function () {
          ensureMysteryGlowPin();
          flyToMysteryGlow(0);
        });
      }

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'p' && e.key !== 'P') return;
        var tag = (e.target && e.target.tagName) || '';
        if (tag === 'INPUT' || tag === 'TEXTAREA' || (e.target && e.target.isContentEditable)) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        e.preventDefault();
        captureObservatoryPin();
      });

      // --- One-tap snapshot (Atlas / Aladin only) ----------------------------------
      // getViewDataURL renders ONLY the sky canvas — so it bakes in the reticle and misses HTML
      // overlays like the SIMBAD info box. We fix both: hide the reticle for the capture, then
      // composite the SIMBAD box (a floating DOM element) onto the sky image before saving.
      function saveSnap(url) {
        if (!url) return;
        var name = 'observatory-' + new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19) + '.png';
        var link = document.createElement('a');
        link.href = url;
        link.download = name;
        document.body.appendChild(link);
        link.click();
        link.remove();
      }

      function roundRect(cx, x, y, w, h, r) {
        cx.beginPath();
        cx.moveTo(x + r, y);
        cx.arcTo(x + w, y, x + w, y + h, r);
        cx.arcTo(x + w, y + h, x, y + h, r);
        cx.arcTo(x, y + h, x, y, r);
        cx.arcTo(x, y, x + w, y, r);
        cx.closePath();
      }

      // Find a visible SIMBAD/object popup inside the Aladin container, if one is open.
      function findPopup(div) {
        if (!div) return null;
        var cand = div.querySelectorAll('[class*="popup"], [class*="Popup"]');
        for (var i = 0; i < cand.length; i++) {
          var el = cand[i];
          if (el.offsetParent !== null && el.innerText && el.innerText.trim().length) return el;
        }
        return null;
      }

      // Draw the popup's text into the snapshot at the same on-screen position.
      function drawPopup(cx, div, imgW) {
        var pop = findPopup(div);
        if (!pop) return;
        var dRect = div.getBoundingClientRect();
        var pRect = pop.getBoundingClientRect();
        var scale = imgW / dRect.width; // CSS px -> image px (≈ devicePixelRatio)
        var x = (pRect.left - dRect.left) * scale;
        var y = (pRect.top - dRect.top) * scale;
        var w = Math.max(pRect.width * scale, 140 * scale);
        var pad = 9 * scale;
        var fontPx = 13 * scale;
        var lines = pop.innerText.split('\n').map(function (s) { return s.trim(); }).filter(Boolean);
        var h = pad * 2 + lines.length * fontPx * 1.38;
        cx.fillStyle = 'rgba(5,7,13,0.9)';
        cx.strokeStyle = 'rgba(255,255,255,0.2)';
        cx.lineWidth = Math.max(1, 1.5 * scale);
        roundRect(cx, x, y, w, h, 9 * scale);
        cx.fill();
        cx.stroke();
        cx.textBaseline = 'top';
        var ly = y + pad;
        for (var j = 0; j < lines.length; j++) {
          cx.font = (j === 0 ? '600 ' : '') + fontPx + 'px system-ui, -apple-system, sans-serif';
          cx.fillStyle = j === 0 ? '#f4f7fc' : '#c4ccda';
          cx.fillText(lines[j], x + pad, ly);
          ly += fontPx * 1.38;
        }
      }

      function compositeAndSave(url, div, imgW) {
        var img = new Image();
        img.onload = function () {
          var cv = document.createElement('canvas');
          cv.width = img.naturalWidth;
          cv.height = img.naturalHeight;
          var cx = cv.getContext('2d');
          cx.drawImage(img, 0, 0);
          try { drawPopup(cx, div, img.naturalWidth); } catch (e) {}
          try { stampWatermarks(cx, cv.width, cv.height); } catch (e) {}
          try { saveSnap(cv.toDataURL('image/png')); } catch (e) { saveSnap(url); }
        };
        img.onerror = function () { saveSnap(url); };
        img.src = url;
      }

      // --- Watermarks: brand every shared image as Dragon Lady Observatory ---------
      // Reuses the locked assets + corner rules from the home share-card (index.astro):
      //   dragon (bottom-left): /watermarks/dragon-watermark.png  (fallback .webp)
      //   Dragon Lady (top-right): /watermarks/dragon-lady-mark.jpg  (brightened 1.15x)
      // Preloaded once on page load; stamped onto Atlas snapshots.
      var wmDragon = null, wmLady = null;

      function loadImg(src) {
        return new Promise(function (resolve) {
          var im = new Image();
          im.onload = function () { resolve(im); };
          im.onerror = function () { resolve(null); };
          im.src = src;
        });
      }

      // Light prep so the fixed assets read as faint watermarks on a dark sky (strip near-white box,
      // soft-fade light edges, mildly darken — or brighten, factor > 1 — the subject). Ported from index.astro.
      function prepareWatermarkForDarkBg(originalImg, darkenFactor) {
        return new Promise(function (resolve) {
          if (!originalImg || !originalImg.complete || originalImg.naturalWidth === 0) { resolve(originalImg); return; }
          try {
            var off = document.createElement('canvas');
            off.width = originalImg.naturalWidth;
            off.height = originalImg.naturalHeight;
            var octx = off.getContext('2d', { willReadFrequently: true });
            octx.drawImage(originalImg, 0, 0, off.width, off.height);
            var id = octx.getImageData(0, 0, off.width, off.height);
            var d = id.data;
            for (var i = 0; i < d.length; i += 4) {
              var r = d[i], g = d[i + 1], b = d[i + 2], origA = d[i + 3];
              var avg = (r + g + b) / 3;
              var desat = (Math.max(r, g, b) - Math.min(r, g, b)) < 30;
              if ((desat && avg > 40 && avg < 250) || avg > 235) {
                d[i + 3] = 0;
              } else if (avg > 210) {
                var fade = Math.max(0, (avg - 210) / 25);
                d[i + 3] = Math.floor((origA || 255) * (1 - fade));
              } else {
                d[i] = Math.floor(r * darkenFactor);
                d[i + 1] = Math.floor(g * darkenFactor);
                d[i + 2] = Math.floor(b * darkenFactor);
                d[i + 3] = (origA < 250) ? Math.max(20, Math.floor(origA * 0.9)) : 255;
              }
            }
            octx.putImageData(id, 0, 0);
            var processed = new Image();
            processed.onload = function () { resolve(processed); };
            processed.onerror = function () { resolve(originalImg); };
            processed.src = off.toDataURL('image/png');
          } catch (e) { resolve(originalImg); }
        });
      }

      (function loadWatermarks() {
        loadImg('/watermarks/dragon-watermark.png')
          .then(function (d) { return d || loadImg('/watermarks/dragon-watermark.webp'); })
          .then(function (d) { if (d) prepareWatermarkForDarkBg(d, 0.8).then(function (p) { wmDragon = p; }); });
        loadImg('/watermarks/dragon-lady-mark.jpg')
          .then(function (l) { if (l) prepareWatermarkForDarkBg(l, 1.15).then(function (p) { wmLady = p; }); });
      })();

      // Stamp both marks in their corners, sized proportional to the image.
      // Quieter than the home share-card — Atlas snaps are sky-first; brand stays a whisper.
      // Dragon bottom-left, Lady top-right. (Share cards on index keep their stronger alphas.)
      function stampWatermarks(cx, w, h) {
        var margin = Math.round(w * 0.012);
        if (wmDragon && wmDragon.complete && wmDragon.naturalWidth > 0) {
          var dw = Math.round(w * 0.085), dh = Math.round(dw * (100 / 135));
          cx.save();
          cx.globalAlpha = 0.24;
          cx.drawImage(wmDragon, margin, h - dh - margin, dw, dh);
          cx.restore();
        }
        if (wmLady && wmLady.complete && wmLady.naturalWidth > 0) {
          var lw = Math.round(w * 0.07), lh = Math.round(lw * (95 / 115));
          cx.save();
          cx.globalAlpha = 0.26;
          cx.drawImage(wmLady, w - lw - margin, margin, lw, lh);
          cx.restore();
        }
      }

      // Hide marker/selection overlays (e.g. the magenta SIMBAD circle) for a clean capture, then restore.
      var hiddenOverlays = [];
      function hideMarkers(a) {
        hiddenOverlays = [];
        try {
          var ovs = (typeof a.getOverlays === 'function') ? a.getOverlays() : null;
          if (ovs && ovs.forEach) {
            ovs.forEach(function (o) {
              try { if (o.isShowing !== false && typeof o.hide === 'function') { o.hide(); hiddenOverlays.push(o); } } catch (e) {}
            });
          }
        } catch (e) {}
      }
      function restoreMarkers() {
        hiddenOverlays.forEach(function (o) { try { if (typeof o.show === 'function') o.show(); } catch (e) {} });
        hiddenOverlays = [];
      }

      // Atlas (Aladin): native canvas capture, with reticle + selection markers hidden, SIMBAD box composited in.
      function captureAladin() {
        var a = window.__aladin;
        if (!a) { alert('Atlas is still loading — give it a moment, then try again.'); return; }
        var div = document.getElementById('aladin-lite-div');
        try { if (typeof a.showReticle === 'function') a.showReticle(false); } catch (e) {}
        hideMarkers(a);
        try { if (typeof a.requestRedraw === 'function') a.requestRedraw(); } catch (e) {}
        setTimeout(function () {
          function done() {
            try { if (typeof a.showReticle === 'function') a.showReticle(true); } catch (e) {}
            restoreMarkers();
            try { if (typeof a.requestRedraw === 'function') a.requestRedraw(); } catch (e) {}
          }
          try {
            if (typeof a.getViewDataURL === 'function') {
              var res = a.getViewDataURL({ format: 'image/png' });
              if (res && typeof res.then === 'function') { res.then(function (u) { compositeAndSave(u, div); done(); }); return; }
              if (typeof res === 'string') { compositeAndSave(res, div); done(); return; }
            }
            if (typeof a.exportAsPNG === 'function') { a.exportAsPNG(); done(); return; }
            done();
            alert('Snapshot is not available in this Atlas build.');
          } catch (e) {
            done();
            alert('Could not capture the view: ' + (e && e.message ? e.message : 'unknown error'));
          }
        }, 120);
      }

      // WWT/Explore capture removed. Only Atlas native capture remains.

      if (snapshotBtn) {
        snapshotBtn.addEventListener('click', function () {
          captureAladin();
        });
      }

      // Wide Sky / Globe mode: Aladin zoomed way out acts like a draggable sky globe.
      // Lets you see what's "above" different parts of the Earth by panning the all-sky view.
      const wideBtn = document.getElementById('wide-sky-btn');
      if (wideBtn) {
        wideBtn.addEventListener('click', function () {
          const a = window.__aladin;
          if (!a) return;
          try {
            // Very wide field for the globe effect (user discovered this by zooming out)
            if (typeof a.setFov === 'function') a.setFov(160);
          } catch (e) {}
          // When going wide (globe-ish), ensure header is gone and our custom buttons are moved
          // to a stable corner so they don't fight Aladin's layout.
          const header = document.querySelector('header');
          if (header) {
            header.style.setProperty('display', 'none', 'important');
            header.style.setProperty('visibility', 'hidden', 'important');
            header.style.setProperty('height', '0px', 'important');
          }
          setTimeout(forceHideHeaderIfImmersive, 30);
        });
      }

      // === PARK CAMERA CONTROLS WHEN ALADIN GOES IMMERSIVE ===
      // Aladin's internal fullscreen makes #aladin-lite-div position:fixed full-window while
      // #sky-controls stay inside #sky-stage (mid-page). Even position:fixed can be trapped by
      // a containing block on the stage — buttons look "moved up" into the middle of the sky.
      // Fix: detect immersive, reparent controls onto <body>, pin to real viewport bottom.
      var parkedOnBody = false;

      function clearParkStyles(el) {
        if (!el) return;
        el.classList.remove('dlo-fs-park');
        [
          'position', 'bottom', 'right', 'top', 'left', 'transform',
          'opacity', 'z-index', 'display', 'visibility',
        ].forEach(function (p) { el.style.removeProperty(p); });
      }

      function parkInto(host) {
        if (!host) host = document.body;
        var controls = document.getElementById('sky-controls');
        var surveyToggle = document.getElementById('survey-toggle');
        var chip = document.getElementById('now-chip');
        // Append as last children so they paint above Aladin's canvas layers.
        if (surveyToggle && surveyToggle.parentElement !== host) host.appendChild(surveyToggle);
        if (chip && chip.parentElement !== host) host.appendChild(chip);
        if (controls && controls.parentElement !== host) host.appendChild(controls);
        if (controls) controls.classList.add('dlo-fs-park');
        if (surveyToggle) surveyToggle.classList.add('dlo-fs-park');
        if (chip) chip.classList.add('dlo-fs-park');
        // Inline pin as well — class alone may lose if host isn't body.
        if (controls) {
          controls.style.setProperty('position', 'fixed', 'important');
          controls.style.setProperty('bottom', '12px', 'important');
          controls.style.setProperty('right', '12px', 'important');
          controls.style.setProperty('top', 'auto', 'important');
          controls.style.setProperty('left', 'auto', 'important');
          controls.style.setProperty('z-index', '2147483000', 'important');
          controls.style.setProperty('opacity', '0.92', 'important');
        }
        if (surveyToggle) {
          surveyToggle.style.setProperty('position', 'fixed', 'important');
          surveyToggle.style.setProperty('bottom', '14px', 'important');
          surveyToggle.style.setProperty('left', '50%', 'important');
          surveyToggle.style.setProperty('top', 'auto', 'important');
          surveyToggle.style.setProperty('right', 'auto', 'important');
          surveyToggle.style.setProperty('transform', 'translateX(-50%)', 'important');
          surveyToggle.style.setProperty('z-index', '2147483000', 'important');
          surveyToggle.style.setProperty('opacity', '0.92', 'important');
        }
        if (chip) chip.style.setProperty('display', 'none', 'important');
        parkedOnBody = true;
      }

      function parkOnBody() { parkInto(document.body); }

      function restoreToStage() {
        var stage = document.getElementById('sky-stage');
        if (!stage) return;
        var controls = document.getElementById('sky-controls');
        var surveyToggle = document.getElementById('survey-toggle');
        var chip = document.getElementById('now-chip');
        // Put back in original order: survey, chip, controls (matches markup).
        if (surveyToggle) {
          clearParkStyles(surveyToggle);
          if (surveyToggle.parentElement !== stage) stage.appendChild(surveyToggle);
        }
        if (chip) {
          clearParkStyles(chip);
          if (chip.parentElement !== stage) stage.appendChild(chip);
        }
        if (controls) {
          clearParkStyles(controls);
          if (controls.parentElement !== stage) stage.appendChild(controls);
        }
        parkedOnBody = false;
      }

      function detectImmersive() {
        var fs = document.fullscreenElement || document.webkitFullscreenElement;
        if (fs) {
          return { mode: 'std', el: fs };
        }
        var aladin = document.getElementById('aladin-lite-div');
        if (!aladin) return null;
        var rect = aladin.getBoundingClientRect();
        var style = window.getComputedStyle(aladin);
        var nearlyFull =
          rect.width > window.innerWidth * 0.85 &&
          rect.height > window.innerHeight * 0.85;
        var pinnedFixed = style.position === 'fixed' && nearlyFull;
        var nearTopFull = nearlyFull && rect.top < 12;
        if (pinnedFixed || nearTopFull) return { mode: 'aladin', el: aladin };
        if (
          nearlyFull &&
          (style.position === 'absolute' || style.position === 'fixed') &&
          (parseInt(style.zIndex, 10) > 100 || rect.top < 40)
        ) {
          return { mode: 'aladin', el: aladin };
        }
        return null;
      }

      function forceHideHeaderIfImmersive() {
        var header = document.querySelector('header');
        var immersive = detectImmersive();

        if (immersive) {
          if (header) {
            header.style.setProperty('display', 'none', 'important');
            header.style.setProperty('visibility', 'hidden', 'important');
            header.style.setProperty('height', '0', 'important');
            header.style.setProperty('overflow', 'hidden', 'important');
            header.style.setProperty('margin', '0', 'important');
            header.style.setProperty('padding', '0', 'important');
          }

          // Always reparent into the visible fullscreen host (fs element, or body for
          // Aladin's fake expand). Body-only park is invisible during true fullscreen.
          var host = immersive.mode === 'std' ? immersive.el : document.body;
          parkInto(host);
        } else {
          if (header) {
            header.style.removeProperty('display');
            header.style.removeProperty('visibility');
            header.style.removeProperty('height');
            header.style.removeProperty('overflow');
            header.style.removeProperty('margin');
            header.style.removeProperty('padding');
          }
          restoreToStage();
        }
      }

      ['fullscreenchange', 'webkitfullscreenchange', 'mozfullscreenchange', 'MSFullscreenChange']
        .forEach(function (evt) { document.addEventListener(evt, forceHideHeaderIfImmersive); });

      window.addEventListener('resize', forceHideHeaderIfImmersive);

      var stageObs = document.getElementById('sky-stage');
      if (stageObs && typeof ResizeObserver !== 'undefined') {
        var ro = new ResizeObserver(function () { forceHideHeaderIfImmersive(); });
        ro.observe(stageObs);
      }

      var aladinDiv = document.getElementById('aladin-lite-div');
      if (aladinDiv) {
        if (typeof ResizeObserver !== 'undefined') {
          var ro2 = new ResizeObserver(function () { forceHideHeaderIfImmersive(); });
          ro2.observe(aladinDiv);
        }

        var forceHideNow = function () {
          var header = document.querySelector('header');
          if (header) {
            header.style.setProperty('display', 'none', 'important');
            header.style.setProperty('visibility', 'hidden', 'important');
            header.style.setProperty('height', '0px', 'important');
            header.style.setProperty('overflow', 'hidden', 'important');
            header.style.setProperty('margin', '0', 'important');
            header.style.setProperty('padding', '0', 'important');
          }
          setTimeout(forceHideHeaderIfImmersive, 30);
          setTimeout(forceHideHeaderIfImmersive, 120);
          setTimeout(forceHideHeaderIfImmersive, 400);
        };

        aladinDiv.addEventListener('pointerdown', forceHideNow, { capture: true });
        aladinDiv.addEventListener('mousedown', forceHideNow, { capture: true });
        aladinDiv.addEventListener('click', forceHideNow, { capture: true });

        if (typeof MutationObserver !== 'undefined') {
          var mo = new MutationObserver(function () {
            forceHideHeaderIfImmersive();
          });
          mo.observe(aladinDiv, { attributes: true, attributeFilter: ['style', 'class'], childList: false, subtree: false });
        }
      }

      setInterval(forceHideHeaderIfImmersive, 180);
      setTimeout(forceHideHeaderIfImmersive, 50);
      setTimeout(forceHideHeaderIfImmersive, 250);
      setTimeout(forceHideHeaderIfImmersive, 700);
      setTimeout(forceHideHeaderIfImmersive, 1400);

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          setTimeout(forceHideHeaderIfImmersive, 50);
          setTimeout(forceHideHeaderIfImmersive, 200);
        }
      });

      setTimeout(forceHideHeaderIfImmersive, 250);
    })();
  </script>
