---
import Base from '@/layouts/Base.astro';
const base = import.meta.env.BASE_URL;

const events = [
  { id: 'moon', name: 'Moon', desc: 'Our nearest neighbor — always a good test target for the camera.' },
  { id: 'venus-evening', name: 'Venus', desc: 'Brightest planet in the evening or morning sky. Great for testing jumps.' },
  { id: 'perseids', name: 'Perseid Meteor Shower', desc: 'Fast, bright meteors (peak in August).' },
  { id: 'geminids', name: 'Geminids Meteor Shower', desc: 'Reliable December shower — often one of the years best.' },
];

const constellations = [
  { id: 'orion', name: 'Orion', desc: 'The Hunter. One of the most recognizable constellations in the winter sky.' },
  { id: 'pleiades', name: 'Pleiades', desc: 'A delicate cluster of stars, often called the Seven Sisters.' },
  { id: 'andromeda', name: 'Andromeda Galaxy', desc: 'Our nearest major galactic neighbor — visible to the naked eye on dark nights.' },
  { id: 'cassiopeia', name: 'Cassiopeia', desc: 'The Queen. A bright W-shaped constellation in the northern sky.' },
  { id: 'ursa-major', name: 'Ursa Major', desc: 'The Great Bear. Home to the Big Dipper and a reliable northern guide.' },
  { id: 'scorpius', name: 'Scorpius', desc: 'The Scorpion. A striking summer constellation with a bright red heart.' },
];
---

<Base title="Sky Events · Dragon Lady’s Observatory">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="mb-10">
      <a href={base} class="text-lg font-semibold tracking-tight text-mist-100 hover:text-signal-300 hover:no-underline" title="Back to console home">The Observatory</a>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-mist-100 sm:text-4xl">What’s beautiful in the sky tonight?</h1>
      <p class="mt-3 text-mist-300 max-w-2xl text-lg">
        A calm, personal guide to celestial moments worth looking at.<br>
        No alerts. Just wonder.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
      <section class="lg:col-span-3">
        <div class="flex items-center justify-between mb-5">
          <h2 class="text-xl font-medium text-mist-200">What’s Happening Tonight / Soon</h2>
          <span class="text-xs text-mist-500">Tonight + next 7 days</span>
        </div>
        <div class="space-y-4" id="events-grid">
          {events.map((item) => (
            <div
              class="group rounded-2xl border border-void-700 bg-void-900 p-6 hover:border-void-500 hover:-translate-y-0.5 transition-all duration-200 shadow-sm"
              data-sky-tile
              data-type="event"
              data-id={item.id}
              data-name={item.name}
              data-desc={item.desc}
            >
              <div class="flex justify-between items-start">
                <div>
                  <div class="font-medium text-mist-100 text-lg">{item.name}</div>
                  <div class="mt-2 text-mist-300 text-sm leading-snug">{item.desc}</div>
                </div>
                <button type="button" class="pin-btn mt-1 px-4 py-1.5 text-xs rounded-full border border-void-600 text-mist-300 hover:bg-emerald-900/30 hover:border-emerald-700 hover:text-emerald-300 active:bg-emerald-900/50 transition-all">
                  Pin this
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="lg:col-span-2">
        <div class="flex items-center justify-between mb-5">
          <h2 class="text-xl font-medium text-mist-200">Constellation Highlights</h2>
        </div>
        <div class="space-y-4" id="constellations-grid">
          {constellations.map((item) => (
            <div
              class="group rounded-2xl border border-void-700 bg-void-900 p-6 hover:border-void-500 hover:-translate-y-0.5 transition-all duration-200 shadow-sm"
              data-sky-tile
              data-type="constellation"
              data-id={item.id}
              data-name={item.name}
              data-desc={item.desc}
            >
              <div class="flex justify-between items-start">
                <div>
                  <div class="font-medium text-mist-100 text-lg">{item.name}</div>
                  <div class="mt-2 text-mist-300 text-sm leading-snug">{item.desc}</div>
                </div>
                <button type="button" class="pin-btn mt-1 px-4 py-1.5 text-xs rounded-full border border-void-600 text-mist-300 hover:bg-emerald-900/30 hover:border-emerald-700 hover:text-emerald-300 active:bg-emerald-900/50 transition-all">
                  Pin this
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>

    <div class="mt-12 border-t border-void-800 pt-8">
      <div class="text-sm text-mist-400 mb-3">Also worth a look</div>
      <div class="text-mist-300 text-sm max-w-prose">
        The Perseids return every August with swift, bright streaks.
        Andromeda is always there — our nearest major galactic neighbor, visible on dark nights.
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ base }}>
    const defaultViews = {
      moon: { lat: 18, lng: -35, altitude: 1.9 },
      'venus-evening': { lat: 8, lng: -65, altitude: 2.1 },
      perseids: { lat: 52, lng: 46, altitude: 2.0 },
      geminids: { lat: 33, lng: -15, altitude: 2.0 },
      orion: { lat: -8, lng: 84, altitude: 1.8 },
      pleiades: { lat: 24, lng: 58, altitude: 1.9 },
      andromeda: { lat: 41, lng: 10, altitude: 1.9 },
      cassiopeia: { lat: 62, lng: -15, altitude: 1.8 },
      'ursa-major': { lat: 55, lng: 20, altitude: 1.8 },
      scorpius: { lat: -25, lng: 100, altitude: 2.0 },
    };

    function readPins() {
      try {
        const raw = localStorage.getItem('personalPins');
        if (!raw || raw === 'undefined' || raw === 'null') {
          const bak = localStorage.getItem('personalPins:backup');
          if (bak && bak !== 'undefined' && bak !== 'null') {
            const bp = JSON.parse(bak);
            if (Array.isArray(bp) && bp.length) {
              localStorage.setItem('personalPins', JSON.stringify(bp));
              return bp;
            }
          }
          return [];
        }
        const pins = JSON.parse(raw);
        return Array.isArray(pins) ? pins : [];
      } catch (e) {
        return [];
      }
    }

    function writePins(pinsNow) {
      if (!Array.isArray(pinsNow)) return;
      try {
        const prev = localStorage.getItem('personalPins');
        if (prev && prev !== '[]' && prev !== 'undefined' && prev !== 'null') {
          localStorage.setItem('personalPins:backup', prev);
        }
      } catch (e) {}
      localStorage.setItem('personalPins', JSON.stringify(pinsNow));
    }

    document.querySelectorAll('[data-sky-tile]').forEach(function (el) {
      const type = el.getAttribute('data-type');
      const id = el.getAttribute('data-id');
      const name = el.getAttribute('data-name');
      const desc = el.getAttribute('data-desc') || '';
      const sourceEventId = type + ':' + id;
      const btn = el.querySelector('.pin-btn');
      if (!btn) return;

      const pins = readPins();
      if (pins.some(function (p) { return p && p.sourceEventId === sourceEventId; })) {
        btn.textContent = 'Pinned ✓';
        btn.disabled = true;
        btn.classList.add('!border-emerald-700', '!text-emerald-400');
      }

      btn.addEventListener('click', function (e) {
        e.stopImmediatePropagation();
        const pinsNow = readPins();
        const existing = pinsNow.find(function (pin) { return pin.sourceEventId === sourceEventId; });
        const pinId = existing ? existing.id : (Date.now().toString(36) + '-' + id);

        if (!existing) {
          pinsNow.unshift({
            id: pinId,
            createdAt: new Date().toISOString(),
            viewState: defaultViews[id] || { lat: 0, lng: 0, altitude: 2.4 },
            label: name,
            note: desc,
            sourceEventId: sourceEventId,
            source: 'sky-events',
          });
          writePins(pinsNow);
        }

        btn.textContent = 'Pinned ✓';
        btn.disabled = true;
        btn.classList.add('!border-emerald-700', '!text-emerald-400');

        localStorage.setItem('flyToPin', JSON.stringify({
          id: pinId,
          label: name,
          viewState: defaultViews[id] || { lat: 0, lng: 0, altitude: 2.4 },
        }));

        const toast = document.createElement('div');
        toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#0f1420;border:1px solid #36415a;color:#e9edf5;padding:10px 22px;border-radius:9999px;font-size:13px;display:flex;gap:12px;align-items:center;';
        toast.innerHTML = '<span>' + name + ' saved to your pins</span><a href="' + base + 'observatory" style="color:#6fd3e2;text-decoration:none;font-size:12px;">Open in the Observatory →</a>';
        document.body.appendChild(toast);
        setTimeout(function () { toast.remove(); }, 4200);
      });
    });
  </script>

  <div class="mt-12 text-center">
    <a href={base} class="text-xs text-mist-500 hover:text-mist-300">← back to the main console</a>
  </div>
</Base>
