---
import Base from '@/layouts/Base.astro';
import RecordCard from '@/components/RecordCard.astro';
import { allRecords, domainsPresent, loadCatalog } from '@/lib/store';
import { DOMAIN_LABEL } from '@/lib/display';
import type { Domain } from '@/types';

const records = allRecords();
const present = domainsPresent();
const allDomains: Domain[] = ['orbital', 'neo', 'space_weather', 'launch_reentry'];
const base = import.meta.env.BASE_URL;
const catalogCount = loadCatalog().length;

const skyEvents = [
  { id: 'moon', name: 'Moon', desc: 'Our nearest neighbor — always a good test target for the camera.' },
  { id: 'venus-evening', name: 'Venus', desc: 'Brightest planet in the evening or morning sky.' },
  { id: 'perseids', name: 'Perseid Meteor Shower', desc: 'Fast, bright meteors (peak in August).' },
  { id: 'geminids', name: 'Geminids Meteor Shower', desc: 'Reliable December shower — often one of the years best.' },
];

const skyConstellations = [
  { id: 'orion', name: 'Orion', desc: 'The Hunter. Winter sky landmark.' },
  { id: 'pleiades', name: 'Pleiades', desc: 'The Seven Sisters — delicate open cluster.' },
  { id: 'andromeda', name: 'Andromeda Galaxy', desc: 'Nearest major galactic neighbor.' },
  { id: 'cassiopeia', name: 'Cassiopeia', desc: 'Bright W in the northern sky.' },
  { id: 'ursa-major', name: 'Ursa Major', desc: 'Home of the Big Dipper.' },
  { id: 'scorpius', name: 'Scorpius', desc: 'Summer scorpion with a red heart.' },
];
---

<Base title="Dragon Lady’s Observatory">
  <!-- celestial hero — one composition: brand, one line, one CTA -->
  <section class="sky -mx-4 mb-8 rounded-none border-b border-void-800 px-4 py-10 sm:rounded-xl sm:border">
    <div class="relative z-10 max-w-2xl">
      <p class="text-xs uppercase tracking-[0.18em] text-mist-500">Dragon Lady Observatory</p>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight text-mist-100 sm:text-3xl">The sky, watched.</h1>
      <p class="mt-2 text-mist-300">Your pins. Your Atlas. Quiet moments worth keeping.</p>
      <div class="mt-6">
        <a href={base + 'observatory'} class="inline-flex items-center gap-2 rounded-md border border-void-700 px-5 py-2.5 text-sm font-medium text-mist-200 hover:bg-indigo-900/20 hover:border-indigo-700 hover:text-indigo-300 transition-colors">
          Open the Observatory
        </a>
      </div>
    </div>
  </section>

  <!-- My Pins — primary personal shelf -->
  <section class="mb-8">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-xl font-semibold text-mist-100">My Pins</h2>
        <p class="text-xs text-mist-500 mt-0.5">Saved sky views — click a card to fly Atlas there.</p>
      </div>
      <a
        href="#sky-events-inline"
        class="inline-flex items-center gap-1.5 rounded-md border border-void-700 px-3 py-1.5 text-sm text-mist-200 hover:border-void-500 hover:text-mist-100 transition-colors"
      >
        Sky Events
        <span class="text-mist-500 text-xs">↓</span>
      </a>
    </div>

    <div id="pins-restore-bar" class="hidden mb-4 rounded-xl border border-amber-700/50 bg-void-900 p-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="text-sm text-mist-200">
          Shelf looks empty. Restore a backup or re-seed Hi 42 + mystery + HD 23514.
        </div>
        <div class="flex flex-wrap gap-2">
          <button id="restore-pins-backup" type="button" class="px-3 py-1.5 rounded-lg border border-amber-700/60 text-amber-100 hover:bg-amber-900/20 text-sm">
            Restore backup (<span data-backup-count>0</span>)
          </button>
          <button id="seed-known-pins" type="button" class="px-3 py-1.5 rounded-lg border border-void-600 text-mist-200 hover:bg-void-800 text-sm">
            Re-seed known pins
          </button>
        </div>
      </div>
    </div>

    <div class="mb-6">
      <div class="mb-3 flex flex-wrap gap-2" id="pins-chips">
        <button data-chip="all" class="chip px-3 py-1 text-sm rounded-full border border-void-700 bg-void-900 text-mist-300 hover:border-void-500">All</button>
        <button data-chip="favorites" class="chip px-3 py-1 text-sm rounded-full border border-void-700 bg-void-900 text-mist-300 hover:border-void-500">Favorites</button>
        <button data-chip="sky-events" class="chip px-3 py-1 text-sm rounded-full border border-void-700 bg-void-900 text-mist-300 hover:border-void-500" title="Pins you saved from the Sky Events page">Pinned from Sky Events</button>
        <button data-chip="quiet" class="chip px-3 py-1 text-sm rounded-full border border-void-700 bg-void-900 text-mist-300 hover:border-void-500">Quiet</button>
      </div>

      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3">
          <input id="pins-search" type="text" placeholder="Find a pin…"
                 class="text-sm px-3 py-1.5 rounded-lg border border-void-700 bg-void-900 text-mist-200 placeholder:text-mist-500 focus:outline-none focus:border-void-500" style="width:180px;">
          <button id="clear-search" class="text-xs text-mist-500 hover:text-mist-300">clear</button>
          <select id="pins-sort" class="text-sm px-3 py-1.5 rounded-lg border border-void-700 bg-void-900 text-mist-200 focus:outline-none focus:border-void-500">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="favorites">Favorites first</option>
          </select>
        </div>
        <div class="flex flex-wrap gap-2 text-sm">
          <button id="export-pins" class="px-3 py-1.5 rounded-lg border border-void-700 text-mist-300 hover:bg-void-800">Export</button>
          <label class="px-3 py-1.5 rounded-lg border border-void-700 text-mist-300 hover:bg-void-800 cursor-pointer">
            Import
            <input type="file" id="import-pins" accept=".json" class="hidden" />
          </label>
        </div>
      </div>

      <div id="rediscover-strip" class="hidden mb-5 rounded-xl border border-void-700 bg-void-900 p-4">
        <div class="text-xs text-mist-400 mb-2">Quiet views waiting</div>
        <div id="rediscover-items" class="flex flex-wrap gap-3 text-sm"></div>
      </div>

      <div id="pins-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Populated by script below -->
      </div>

      <div id="pins-empty" class="hidden rounded-xl border border-dashed border-void-700 p-8 text-center">
        <p class="text-mist-300">No pins yet. Open the Observatory and press <strong>P</strong> on anything beautiful.</p>
      </div>

      <div id="pins-no-results" class="hidden col-span-full text-center text-mist-400 text-sm py-6">
        No pins match your search.
      </div>
    </div>
  </section>

  <!-- Sky Events — inline tonight list (no Explore detour) -->
  <section class="mb-8" id="sky-events-inline">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-xl font-semibold text-mist-100">Sky Events</h2>
        <p class="text-xs text-mist-500 mt-0.5">Pin one → opens Atlas. No extra page hop.</p>
      </div>
      <a href={base + 'sky-events'} class="text-xs text-mist-500 hover:text-mist-300">Full page ↗</a>
    </div>

    <div class="mb-6">
      <div class="text-xs uppercase tracking-[0.14em] text-mist-500 mb-3">Tonight / soon</div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {skyEvents.map((item) => (
          <div
            class="rounded-xl border border-void-700 bg-void-900 p-4 hover:border-void-500 transition-colors"
            data-sky-tile
            data-type="event"
            data-id={item.id}
            data-name={item.name}
            data-desc={item.desc}
          >
            <div class="flex justify-between items-start gap-3">
              <div class="min-w-0">
                <div class="font-medium text-mist-100">{item.name}</div>
                <div class="mt-1 text-mist-400 text-sm leading-snug">{item.desc}</div>
              </div>
              <button type="button" class="pin-btn shrink-0 px-3 py-1.5 text-xs rounded-full border border-void-600 text-mist-300 hover:bg-emerald-900/30 hover:border-emerald-700 hover:text-emerald-300 transition-all">
                Pin this
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div>
      <div class="text-xs uppercase tracking-[0.14em] text-mist-500 mb-3">Constellations</div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {skyConstellations.map((item) => (
          <div
            class="rounded-xl border border-void-700 bg-void-900 p-4 hover:border-void-500 transition-colors"
            data-sky-tile
            data-type="constellation"
            data-id={item.id}
            data-name={item.name}
            data-desc={item.desc}
          >
            <div class="flex justify-between items-start gap-3">
              <div class="min-w-0">
                <div class="font-medium text-mist-100">{item.name}</div>
                <div class="mt-1 text-mist-400 text-sm leading-snug">{item.desc}</div>
              </div>
              <button type="button" class="pin-btn shrink-0 px-3 py-1.5 text-xs rounded-full border border-void-600 text-mist-300 hover:bg-emerald-900/30 hover:border-emerald-700 hover:text-emerald-300 transition-all">
                Pin this
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Everything overhead (optional, noisy catalog) — heavily de-emphasized; focus is on the personal Observatory -->
  <details class="mb-6 opacity-75">
    <summary class="cursor-pointer text-sm text-mist-400 hover:text-mist-200 mb-4 select-none">
      Everything overhead (optional — the full noisy catalog view)
    </summary>

    <!-- layer toggles + tier legend (de-emphasized) -->
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3 opacity-85">
      <div class="flex flex-wrap items-center gap-2">
        <button class="layer-btn active rounded-full border border-signal-400 bg-void-800 px-3 py-1 text-sm !text-mist-100" data-layer="all">All</button>
        {allDomains.map((d) => (
          <button
            class="layer-btn rounded-full border border-void-700 bg-void-900 px-3 py-1 text-sm text-mist-300 disabled:opacity-40"
            data-layer={d}
            disabled={!present.includes(d)}
            title={present.includes(d) ? '' : 'no data yet'}
          >{DOMAIN_LABEL[d]}</button>
        ))}
      </div>
      <div class="flex items-center gap-3 text-xs text-mist-400/80" title="Tiers reflect interest level, not urgency.">
        <span class="flex items-center gap-1"><span class="inline-block h-1.5 w-1.5 rounded-full dot-t1"></span>T1</span>
        <span class="flex items-center gap-1"><span class="inline-block h-1.5 w-1.5 rounded-full dot-t2"></span>T2</span>
        <span class="flex items-center gap-1"><span class="inline-block h-1.5 w-1.5 rounded-full dot-t3"></span>T3</span>
      </div>
    </div>

    <!-- browse-catalog hatch (softened) -->
    <a href={base + 'catalog'} class="mb-4 flex items-center justify-between rounded-lg border border-void-800 bg-void-900 px-4 py-3 text-sm hover:border-void-600 hover:!no-underline opacity-85">
      <span class="!text-mist-200">🛰 Browse everything up there — <strong class="text-mist-100">{catalogCount.toLocaleString()}</strong> things overhead</span>
      <span class="text-signal-400">search →</span>
    </a>

    {records.length === 0 ? (
      <div class="rounded-lg border border-dashed border-void-700 p-8 text-center">
        <p class="text-mist-300">The sky feels quiet right now. Take your time exploring.</p>
      </div>
    ) : (
      <div id="grid" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {records.map((r) => <RecordCard record={r} />)}
      </div>
    )}

    <script is:inline>
      const btns = document.querySelectorAll('.layer-btn');
      const cards = document.querySelectorAll('.record-card');
      btns.forEach((b) => b.addEventListener('click', () => {
        const layer = b.dataset.layer;
        btns.forEach((x) => {
          const on = x === b;
          x.classList.toggle('active', on);
          x.classList.toggle('border-signal-400', on);
          x.classList.toggle('!text-mist-100', on);
          x.classList.toggle('border-void-700', !on);
          x.classList.toggle('text-mist-300', !on);
        });
        cards.forEach((c) => {
          c.style.display = (layer === 'all' || c.dataset.domain === layer) ? '' : 'none';
        });
      }));
    </script>
  </details>

  <script is:inline define:vars={{ base }}>
  const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  }[char]));

  const safeNumber = (value, fallback = 0) => {
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed : fallback;
  };

  function degToHms(raDeg) {
    var x = ((Number(raDeg) % 360) + 360) % 360 / 15;
    var h = Math.floor(x);
    var mFloat = (x - h) * 60;
    var m = Math.floor(mFloat);
    var s = (mFloat - m) * 60;
    return String(h).padStart(2, '0') + ' ' + String(m).padStart(2, '0') + ' ' + s.toFixed(1).padStart(4, '0');
  }

  function degToDms(decDeg) {
    var sign = Number(decDeg) < 0 ? '-' : '+';
    var x = Math.abs(Number(decDeg));
    var d = Math.floor(x);
    var mFloat = (x - d) * 60;
    var m = Math.floor(mFloat);
    var s = (mFloat - m) * 60;
    return sign + String(d).padStart(2, '0') + ' ' + String(m).padStart(2, '0') + ' ' + s.toFixed(0).padStart(2, '0');
  }

  /** Best sky coords for a pin: top-level ra/dec/fov, else viewState. */
  function resolveSkyCoords(pin) {
    const vs = pin.viewState || {};
    const ra = Number(pin.ra != null ? pin.ra : vs.ra);
    const dec = Number(pin.dec != null ? pin.dec : vs.dec);
    const fov = Number(pin.fov != null ? pin.fov : (vs.fov != null ? vs.fov : vs.altitude));
    const hasSky = Number.isFinite(ra) && Number.isFinite(dec);
    return {
      ra: hasSky ? ra : NaN,
      dec: hasSky ? dec : NaN,
      fov: Number.isFinite(fov) && fov > 0 ? fov : NaN,
      hasSky,
    };
  }

  // Default Atlas boot (M42). Pins that still carry these coords under another label
  // got poisoned during earlier Orion slingshots — strip them so label/Sesame can win.
  const M42_RA = 83.822;
  const M42_DEC = -5.391;
  const PINS_KEY = 'personalPins';
  const PINS_BACKUP_KEY = 'personalPins:backup';
  const PINS_BACKUP_META = 'personalPins:backupMeta';

  function isNearM42(ra, dec) {
    if (!Number.isFinite(ra) || !Number.isFinite(dec)) return false;
    const dra = Math.abs((((ra - M42_RA) % 360) + 540) % 360 - 180);
    const ddec = Math.abs(dec - M42_DEC);
    return dra < 1.5 && ddec < 1.5;
  }
  function labelLooksLikeM42(label) {
    const s = String(label || '').trim().toLowerCase();
    if (!s) return false;
    return /\bm\s*42\b/.test(s) || /\borion\s+nebula\b/.test(s) || /^orion$/.test(s) || /\bhi\s*42\b/.test(s);
  }
  function extractCatalogId(label) {
    const target = String(label || '').trim();
    const catalog = target.match(/\b((?:HD|HR|HIP|NGC|IC|M|Messier)\s*\d+[a-z]?)\b/i);
    if (!catalog) return null;
    return catalog[1].replace(/\s+/g, ' ').replace(/^messier\s*/i, 'M').replace(/^m\s+/i, 'M');
  }

  function coercePinsArray(raw) {
    if (Array.isArray(raw)) return raw.filter(Boolean);
    if (raw && typeof raw === 'object') {
      // Legacy/object-shaped store — never treat as empty wipe fuel.
      const vals = Object.values(raw).filter(function (p) { return p && typeof p === 'object'; });
      if (vals.length) return vals;
    }
    return [];
  }

  function readPinsRaw() {
    try {
      const txt = localStorage.getItem(PINS_KEY);
      if (txt == null || txt === '' || txt === 'undefined' || txt === 'null') return [];
      return coercePinsArray(JSON.parse(txt));
    } catch (e) {
      return [];
    }
  }

  function readPinsBackup() {
    try {
      const txt = localStorage.getItem(PINS_BACKUP_KEY);
      if (txt == null || txt === '' || txt === 'undefined' || txt === 'null') return [];
      return coercePinsArray(JSON.parse(txt));
    } catch (e) {
      return [];
    }
  }

  /** Snapshot non-empty pin lists before automated rewrites. */
  function backupPinsIfNeeded(pins) {
    if (!Array.isArray(pins) || pins.length === 0) return;
    try {
      localStorage.setItem(PINS_BACKUP_KEY, JSON.stringify(pins));
      localStorage.setItem(PINS_BACKUP_META, JSON.stringify({ at: new Date().toISOString(), count: pins.length }));
    } catch (e) {}
  }

  /**
   * Safe write: never replace a non-empty store with [] unless allowEmpty.
   * Always refresh backup when writing a non-empty list.
   */
  function safeWritePins(nextPins, opts) {
    opts = opts || {};
    const allowEmpty = !!opts.allowEmpty;
    if (!Array.isArray(nextPins)) {
      console.warn('[pins] refused to write non-array');
      return false;
    }
    const current = readPinsRaw();
    if (nextPins.length === 0 && current.length > 0 && !allowEmpty) {
      console.warn('[pins] refused to wipe', current.length, 'pins with empty write');
      backupPinsIfNeeded(current);
      return false;
    }
    if (current.length > 0) backupPinsIfNeeded(current);
    try {
      const payload = JSON.stringify(nextPins);
      if (typeof payload !== 'string') {
        console.warn('[pins] stringify failed');
        return false;
      }
      localStorage.setItem(PINS_KEY, payload);
      if (nextPins.length > 0) backupPinsIfNeeded(nextPins);
      return true;
    } catch (e) {
      console.warn('[pins] write failed', e);
      return false;
    }
  }

  /** If main key is empty but backup has pins, restore them. */
  function restorePinsFromBackupIfEmpty() {
    const current = readPinsRaw();
    if (current.length > 0) return { restored: false, pins: current };
    const backup = readPinsBackup();
    if (backup.length === 0) return { restored: false, pins: current };
    const ok = safeWritePins(backup, { allowEmpty: false });
    return { restored: ok, pins: ok ? backup : current, count: backup.length };
  }

  /**
   * Last-resort seed for the known Jul 10 session pins if both main + backup are empty.
   * Does not invent unknown pins — mystery glow + HD 23514 + Hi 42 favorite.
   */
  function seedKnownSessionPinsIfEmpty(pins) {
    if (Array.isArray(pins) && pins.length > 0) return pins;
    const HD_RA = 56.65996751;
    const HD_DEC = 22.91977776;
    const M42_RA = 83.8221;
    const M42_DEC = -5.3911;
    const seeded = [
      {
        id: 'favorite-m42-orion-nebula',
        createdAt: new Date().toISOString(),
        label: 'M42 · Orion Nebula',
        note: 'Hi 42 — Hitchhiker nod. Favorite pin (no longer the Atlas boot default). 05 35 17.3  -05 23 28',
        source: 'observatory',
        favorite: true,
        ra: M42_RA,
        dec: M42_DEC,
        fov: 1.5,
        viewState: { lat: M42_DEC, lng: M42_RA, altitude: 1.5, ra: M42_RA, dec: M42_DEC, fov: 1.5 },
        thumbnailData: '',
      },
      {
        id: 'mre7i3zqed9sm',
        createdAt: '2026-07-10T00:37:41.942Z',
        label: 'HD 23514 High Motion Star',
        note: 'Recovered after localStorage wipe · Simbad 03 46 38.39  +22 55 11.2',
        source: 'observatory',
        ra: HD_RA,
        dec: HD_DEC,
        fov: 2.5,
        coordsHealed: 'HD 23514',
        viewState: { lat: HD_DEC, lng: HD_RA, altitude: 2.5, ra: HD_RA, dec: HD_DEC, fov: 2.5 },
        thumbnailData: '',
      },
      {
        id: 'mystery-moon-2026-07-09',
        createdAt: '2026-07-10T00:30:09.592Z',
        label: 'Mystery glow near Moon · Jul 9',
        note: 'Typed coords while bloom was visible under the Moon. Likely DSS saturation (Simbad empty @ 60″). Screenshots archived. 02 47 52.13  +21 23 30.4',
        source: 'observatory',
        ra: 41.96720833333333,
        dec: 21.391777777777776,
        fov: 0.5,
        viewState: {
          lat: 21.391777777777776,
          lng: 41.96720833333333,
          altitude: 0.5,
          ra: 41.96720833333333,
          dec: 21.391777777777776,
          fov: 0.5,
          coo: '02 47 52.13  +21 23 30.4',
        },
        thumbnailData: '',
        recoveryMeta: {
          originalCoordinates: {
            ra: 41.96720833333333,
            dec: 21.391777777777776,
            fov: 0.5,
            coo: '02 47 52.13  +21 23 30.4',
            frame: 'ICRS',
          },
          description: 'Re-seeded after localStorage wipe (2026-07-10)',
        },
      },
    ];
    safeWritePins(seeded);
    return seeded;
  }

  /** Ensure Hi 42 exists as a favorite even when the shelf already has other pins. */
  function ensureM42FavoriteOnConsole(pins) {
    if (!Array.isArray(pins)) return pins;
    const id = 'favorite-m42-orion-nebula';
    const M42_RA = 83.8221;
    const M42_DEC = -5.3911;
    let changed = false;
    const hasFavId = pins.some((p) => p && p.id === id);
    const legacy = pins.find((p) => p && labelLooksLikeM42(p.label));
    if (hasFavId) {
      pins = pins.map((p) => {
        if (!p || p.id !== id) return p;
        if (p.favorite) return p;
        changed = true;
        return Object.assign({}, p, { favorite: true });
      });
    } else if (legacy) {
      pins = pins.map((p) => {
        if (p !== legacy) return p;
        changed = true;
        return Object.assign({}, p, { favorite: true });
      });
    } else {
      changed = true;
      pins = [{
        id: id,
        createdAt: new Date().toISOString(),
        label: 'M42 · Orion Nebula',
        note: 'Hi 42 — Hitchhiker nod. Favorite pin (no longer the Atlas boot default). 05 35 17.3  -05 23 28',
        source: 'observatory',
        favorite: true,
        ra: M42_RA,
        dec: M42_DEC,
        fov: 1.5,
        viewState: { lat: M42_DEC, lng: M42_RA, altitude: 1.5, ra: M42_RA, dec: M42_DEC, fov: 1.5 },
        thumbnailData: '',
      }].concat(pins);
    }
    if (changed) safeWritePins(pins);
    return pins;
  }

  // Only strip true M42-default coords under a non-M42 label. Do NOT strip catalog
  // pins' coords on load — that rewrite path was too aggressive and risked data loss.
  function scrubM42PoisonedPins(pins) {
    if (!Array.isArray(pins)) return pins;
    let changed = false;
    const cleaned = pins.map((pin) => {
      if (!pin || labelLooksLikeM42(pin.label)) return pin;
      const sky = resolveSkyCoords(pin);
      if (!sky.hasSky || !isNearM42(sky.ra, sky.dec)) return pin;
      changed = true;
      const next = Object.assign({}, pin);
      delete next.ra;
      delete next.dec;
      delete next.fov;
      if (next.viewState && typeof next.viewState === 'object') {
        next.viewState = Object.assign({}, next.viewState);
        delete next.viewState.ra;
        delete next.viewState.dec;
        delete next.viewState.fov;
        if (isNearM42(Number(next.viewState.lng), Number(next.viewState.lat))) {
          delete next.viewState.lat;
          delete next.viewState.lng;
          delete next.viewState.altitude;
        }
      }
      return next;
    });
    if (changed) safeWritePins(cleaned);
    return cleaned;
  }

  function pinSourceBadge(pin) {
    if (pin.source === 'observatory' || (pin.id && String(pin.id).indexOf('mystery-moon') === 0)) {
      return { text: 'Atlas', cls: 'text-signal-300/80' };
    }
    if (pin.sourceEventId || pin.source === 'sky-events') {
      return { text: 'Sky Events', cls: 'text-emerald-400/80' };
    }
    if (pin.source === 'telescope') {
      return { text: 'Telescope', cls: 'text-mist-400' };
    }
    return null;
  }

  function buildFlyToPayload(pin) {
    const vs = pin.viewState || {};
    let sky = resolveSkyCoords(pin);
    const catalogId = extractCatalogId(pin.label);
    const labelKey = String(pin.label || '').trim().toLowerCase();
    const isSso = /^(?:next\s+)?(?:full\s+)?(moon|mercury|venus|mars|jupiter|saturn|uranus|neptune)\b/.test(labelKey)
      || /^venus-evening\b/.test(labelKey)
      || labelKey === 'venus' || labelKey === 'moon';
    // Don't ship M42-default coords under a non-M42 label — forces Sesame/label path.
    if (sky.hasSky && isNearM42(sky.ra, sky.dec) && !labelLooksLikeM42(pin.label)) {
      sky = { ra: NaN, dec: NaN, fov: NaN, hasSky: false };
    }
    // Catalog pins: Observatory resolves by name; omit camera-snapshot coords from handoff.
    if (catalogId && !labelLooksLikeM42(pin.label)) {
      sky = { ra: NaN, dec: NaN, fov: Number.isFinite(sky.fov) ? sky.fov : NaN, hasSky: false };
    }
    // Moon/Venus/planets: never ship snapshot coords — Observatory uses live Miriade.
    if (isSso) {
      sky = { ra: NaN, dec: NaN, fov: NaN, hasSky: false };
    }
    const lat = safeNumber(vs.lat, sky.hasSky ? sky.dec : 0);
    const lng = safeNumber(vs.lng, sky.hasSky ? sky.ra : 0);
    const altitude = safeNumber(vs.altitude, Number.isFinite(sky.fov) ? sky.fov : 2.8);
    const payload = {
      id: pin.id,
      label: pin.label,
      viewState: {
        lat,
        lng,
        altitude,
      },
    };
    if (sky.hasSky) {
      payload.ra = sky.ra;
      payload.dec = sky.dec;
      payload.viewState.ra = sky.ra;
      payload.viewState.dec = sky.dec;
      if (Number.isFinite(sky.fov)) {
        payload.fov = sky.fov;
        payload.viewState.fov = sky.fov;
      }
    } else if (Number.isFinite(sky.fov)) {
      payload.fov = sky.fov;
      payload.viewState.fov = sky.fov;
    }
    return payload;
  }

  let activeChip = 'all';

  function getDaysSince(dateStr) {
    if (!dateStr) return 9999;
    return Math.floor((Date.now() - new Date(dateStr).getTime()) / (1000 * 60 * 60 * 24));
  }

  function applyCollectionFilter(pins, chip) {
    if (chip === 'all') return pins;
    if (chip === 'favorites') return pins.filter(p => p.favorite);
    if (chip === 'sky-events') return pins.filter(p => p.sourceEventId);
    if (chip === 'quiet') {
      return pins.filter(p => {
        const date = p.updatedAt || p.createdAt;
        return getDaysSince(date) > 30;
      });
    }
    return pins;
  }

  /**
   * Creates the shareable Observatory card for a pin.
   *
   * Final direction:
   * - The dedicated globe page is retired (quiet Earth view + click-to-go; we kept the saved script if we ever miss it).
   * - The desired "telescope / observatory angle" for sharing is the calm, contemplative, wonder-filled artistic sky.
   * - Globe-style canvas thumbnails are never included in the exported image (they are meaningless even to the creator later).
   * - Every share is a pure, self-contained artistic Observatory card: rich gradient sky + stars + minimal poetic text + the two watermarks.
   *
   * Watermarks (locked rules):
   * - Default faint dragon: bottom left, always present, cannot be turned off.
   * - Personal Dragon Lady mark (project owner): top right for creator pins.
   */
  async function createShareableImage(pin) {
    const viewState = pin.viewState || {};
    const lat = safeNumber(viewState.lat);
    const lng = safeNumber(viewState.lng);
    const label = pin.label || 'Saved View';
    const dateStr = pin.createdAt ? new Date(pin.createdAt).toLocaleDateString() : '';
    const isTelescope = pin.source === 'telescope' && !!pin.thumbnailData;
    const spectrum = viewState.spectrum ? String(viewState.spectrum).toUpperCase() : '';

    // Core background painter — rich gradient + subtle stars (never pure black). Used for non-telescope or fallback.
    function drawRichSky(ctx, w, h) {
      const hue = Math.floor(((lat + 90) / 180) * 360);
      const sat = 38 + Math.floor(Math.abs(lng) % 35);
      const light = 32 + Math.floor(Math.abs(lat) % 18);

      // Slightly brighter night gradient so stars and text read well
      const g = ctx.createLinearGradient(0, 0, w, h);
      g.addColorStop(0, `hsl(${hue}, ${sat + 8}%, ${Math.max(16, light + 2)}%)`);
      g.addColorStop(1, `hsl(${hue + 22}, ${sat + 2}%, ${Math.max(10, light - 8)}%)`);
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, w, h);

      // Deterministic stars (same pin = same quiet field)
      ctx.fillStyle = 'rgba(233,237,245,0.6)';
      const starSeed = Math.floor(Math.abs(lat) * 100 + Math.abs(lng) * 17) % 200;
      for (let i = 0; i < 52; i++) {
        const x = ((starSeed + i * 37) % (w - 36)) + 18;
        const y = ((starSeed + i * 19) % (h - 120)) + 18;
        const r = ((i % 3) === 0) ? 1.15 : 0.65;
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // Full pretty card used when there is no usable telescope thumbnail.
    function drawPrettyFallback(ctx, w, h, dragonImg, ladyImg) {
      drawRichSky(ctx, w, h);

      ctx.fillStyle = '#e9edf5';
      ctx.font = 'bold 32px system-ui';
      ctx.fillText(label, 48, h * 0.38);

      ctx.font = '18px system-ui';
      ctx.fillStyle = '#aab4c7';
      ctx.fillText(dateStr ? `Pinned ${dateStr}` : 'A quiet view worth keeping', 48, h * 0.38 + 38);

      // Watermarks in the correct corners (passed in)
      drawWatermarks(ctx, w, h, dragonImg, ladyImg);
    }

    // Fixed watermark assets:
    //   dragon (bottom-left): /watermarks/dragon-watermark.png (or .webp)
    //   lady (top-right): /watermarks/dragon-lady-mark.jpg  ← brightened 1.15x in prepare (project owner tweak: was too dark)
    //
    // Load them directly and draw them at faint alpha in locked corners.

    async function loadWatermarkAssets() {
      // Preserve the supplied artwork; only apply the minimal background cleanup
      // needed for the artwork to blend into dark share cards.

      const dragonImg = new Image();
      const ladyImg = new Image();

      // Dragon: the fixed .png (or fallback .webp) — load, then prepare (bg strip if any + mild darken of art for dark bg).
      const dragonLoaded = await new Promise((resolve) => {
        dragonImg.onload = () => resolve(true);
        dragonImg.onerror = () => resolve(false);
        dragonImg.src = '/watermarks/dragon-watermark.png';
      });
      if (!dragonLoaded) {
        await new Promise((resolve) => {
          dragonImg.onload = () => resolve(true);
          dragonImg.onerror = () => resolve(false);
          dragonImg.src = '/watermarks/dragon-watermark.webp';
        });
      }

      // Lady: the fixed .jpg (scenic) — load, then prepare (strip bg to kill box + mild darken of subject for visibility).
      await new Promise((resolve) => {
        ladyImg.onload = () => resolve(true);
        ladyImg.onerror = () => resolve(false);
        ladyImg.src = '/watermarks/dragon-lady-mark.jpg';
      });

      // Dragon (bottom-left): mild darken for contrast on dark card (preserve the blue icon look)
      const preparedDragon = await prepareWatermarkForDarkBg(dragonImg, 0.8);
      // Lady (top-right): brighten a bit (factor >1) per your tweak — was too dark; keep the scenic art visible without box
      const preparedLady = await prepareWatermarkForDarkBg(ladyImg, 1.15);

      return { dragonImg: preparedDragon, ladyImg: preparedLady };
    }

    // Minimal prepare for the fixed assets (applied to both in load) so they work as faint watermarks on dark card.
    // - Strips near-white/light desat bg to transparent (prevents jpg from being a solid rect "box").
    // - For kept subject pixels (the actual art from the provided files): mildly darken them (or brighten for lady).
    //   This helps the light-colored lady scene and the dragon head show up at low globalAlpha on the dark blue bg + veil.
    // - NO heavy contrast/boost that caused "bright fill" before, NO recreating art or adding silhouettes — just enough prep to make the exact assets you provided visible and not empty boxes.
    // Dragon png keeps its original transparency; lady jpg gets bg removed + subject prepped (less darken for lady per your tweak).
    async function prepareWatermarkForDarkBg(originalImg, darkenFactor = 0.85) {
      if (!originalImg || !originalImg.complete || originalImg.naturalWidth === 0) {
        return originalImg;
      }
      return new Promise((resolve) => {
        const offCanvas = document.createElement('canvas');
        offCanvas.width = originalImg.naturalWidth || originalImg.width;
        offCanvas.height = originalImg.naturalHeight || originalImg.height;
        const offCtx = offCanvas.getContext('2d', { willReadFrequently: true });
        offCtx.drawImage(originalImg, 0, 0, offCanvas.width, offCanvas.height);

        const imageData = offCtx.getImageData(0, 0, offCanvas.width, offCanvas.height);
        const data = imageData.data;

        for (let i = 0; i < data.length; i += 4) {
          const r = data[i];
          const g = data[i + 1];
          const b = data[i + 2];
          const origA = data[i + 3];
          const avg = (r + g + b) / 3;
          const maxC = Math.max(r, g, b);
          const minC = Math.min(r, g, b);
          const isDesaturated = (maxC - minC) < 30;

          if ((isDesaturated && avg > 40 && avg < 250) || avg > 235) {
            // bg / mist / near white -> transparent (kills the box for the scenic jpg)
            data[i + 3] = 0;
          } else if (avg > 210) {
            // soft fade on very light edges
            const fade = Math.max(0, (avg - 210) / 25);
            data[i + 3] = Math.floor((origA || 255) * (1 - fade));
          } else {
            // subject art from the provided asset — preserve the look, but mildly darken (or brighten if factor >1) so it reads on dark bg at low alpha
            // (no "recreation", just usability prep for watermark on dark card)
            data[i] = Math.floor(r * darkenFactor);
            data[i + 1] = Math.floor(g * darkenFactor);
            data[i + 2] = Math.floor(b * darkenFactor);
            data[i + 3] = (origA < 250) ? Math.max(20, Math.floor(origA * 0.9)) : 255;
          }
        }

        offCtx.putImageData(imageData, 0, 0);

        const processed = new Image();
        processed.onload = () => resolve(processed);
        processed.onerror = () => resolve(originalImg);
        processed.src = offCanvas.toDataURL('image/png');
      });
    }

    // DEPRECATED / NO-OP for final preserved watermarks (2026-06-03).
    // Watermarks are complete. Assets are the fixed delivered files.
    // We no longer recreate or process the images in any way (no pixel stripping, no contrast boost,
    // no alpha forcing, no new canvases). The artist's files are loaded and drawn as-is.
    // This function now returns the original image unchanged to preserve the exact asset.
    async function processImageForTransparentBg(originalImg) {
      // Preservation mode: do not recreate the final watermark assets.
      return originalImg;
    }

    // (Old canvas silhouette helpers removed during cleanup. Watermarks are now strictly the preserved image assets only — no code paths for silhouettes remain.)
    // Watermark assets are intentionally loaded directly without regeneration.

    // Draw both watermarks in the correct corners per locked rules.
    // ONLY load + preserve the fixed assets (see loadWatermarkAssets).
    // No recreation, no processing, no silhouettes, no new generations.
    // These three files from the real repo ARE the final watermarks:
    //   dragon-lady-mark.jpg (top-right Dragon Lady mark)
    //   dragon-watermark.png + .webp (bottom-left dragon)
    //
    // Just composite them at faint alpha in the locked corners on the share card.
    function drawWatermarks(ctx, w, h, dragonImg, ladyImg) {
      // Final preserved (and lightly prepped) assets — draw exactly the art from the fixed files, at alpha tuned for visibility on dark card.
      // Dragon (bottom left, always)
      const dragonAlpha = 0.40;
      if (dragonImg && dragonImg.complete && dragonImg.naturalWidth > 0) {
        ctx.save();
        ctx.globalAlpha = dragonAlpha;
        const dw = 135;
        const dh = 100;
        ctx.drawImage(dragonImg, 15, h - dh - 10, dw, dh);
        ctx.restore();
      }

      // Lady mark (top right)
      const ladyAlpha = 0.45;
      if (ladyImg && ladyImg.complete && ladyImg.naturalWidth > 0) {
        ctx.save();
        ctx.globalAlpha = ladyAlpha;
        const lw = 115;
        const lh = 95;
        ctx.drawImage(ladyImg, w - lw - 15, 15, lw, lh);
        ctx.restore();
      }
    }

    const canvas = document.createElement('canvas');
    canvas.width = 1200;
    canvas.height = 820;
    const ctx = canvas.getContext('2d');

    // Load the fixed, preserved watermark assets (async safe).
    // These are the complete delivered files — no recreation.
    const { dragonImg, ladyImg } = await loadWatermarkAssets();

    if (isTelescope) {
      // Real telescope capture as the heart of the share card (observatory angle).
      // Watermarks (Imagine assets) overlaid faint in locked corners. Minimal poetic text.
      const baseImg = new Image();
      await new Promise((resolve, reject) => {
        baseImg.onload = resolve;
        baseImg.onerror = reject;
        baseImg.src = pin.thumbnailData;
      });

      // Scale to cover the card (center crop feel for calm full view)
      const scale = Math.max(canvas.width / baseImg.width, canvas.height / baseImg.height);
      const dw = baseImg.width * scale;
      const dh = baseImg.height * scale;
      const dx = (canvas.width - dw) / 2;
      const dy = (canvas.height - dh) / 2;
      ctx.drawImage(baseImg, dx, dy, dw, dh);

      // Very subtle artistic veil to keep the calm card feeling (not raw screenshot)
      const veil = ctx.createLinearGradient(0, canvas.height * 0.6, 0, canvas.height);
      veil.addColorStop(0, 'rgba(5,7,13,0.08)');
      veil.addColorStop(1, 'rgba(5,7,13,0.22)');
      ctx.fillStyle = veil;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Minimal poetic text (shifted right to leave clear space for bottom-left dragon watermark)
      // The dragon watermark owns the bottom-left corner; caption starts to its right.
      const captionX = 280; // increased further to give the dragon watermark plenty of room in the bottom-left corner (text was still crowding in user's test)
      ctx.fillStyle = 'rgba(233,237,245,0.75)';
      ctx.font = '600 26px system-ui';
      ctx.fillText(label, captionX, canvas.height - 68);

      ctx.font = '400 16px system-ui';
      ctx.fillStyle = 'rgba(170,180,199,0.65)';
      const extra = spectrum ? ` · ${spectrum}` : '';
      ctx.fillText(dateStr ? `Pinned ${dateStr}${extra}` : `A quiet moment worth keeping${extra}`, captionX, canvas.height - 42);

      // Watermarks last (on top, correct corners) using Imagine assets
      drawWatermarks(ctx, canvas.width, canvas.height, dragonImg, ladyImg);
    } else {
      // Pure calm artistic card for non-telescope pins (the retired globe page never contributed thumbs)
      drawPrettyFallback(ctx, canvas.width, canvas.height, dragonImg, ladyImg);
    }

    return canvas.toDataURL('image/png');
  }

  function renderMyPins() {
    updateChipVisuals();   // safety net: always keep button visuals in sync with activeChip

    const grid = document.getElementById('pins-grid');
    const empty = document.getElementById('pins-empty');
    const noResults = document.getElementById('pins-no-results');

    let pins = readPinsRaw();
    const recovered = restorePinsFromBackupIfEmpty();
    if (recovered.restored) {
      pins = recovered.pins;
      try {
        const toast = document.createElement('div');
        toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:3000;background:#0f1420;border:1px solid #36415a;color:#e9edf5;padding:10px 22px;border-radius:9999px;font-size:13px;';
        toast.textContent = 'Restored ' + recovered.count + ' pins from local backup';
        document.body.appendChild(toast);
        setTimeout(function () { toast.remove(); }, 4200);
      } catch (e) {}
    }
    // Do NOT auto-seed / rewrite the shelf on every load — that felt like "pins changed back."
    // Empty shelf: offer restore/seed via the restore bar only.
    pins = scrubM42PoisonedPins(pins);

    const backup = readPinsBackup();
    const restoreBar = document.getElementById('pins-restore-bar');
    if (restoreBar) {
      if (pins.length === 0) {
        restoreBar.classList.remove('hidden');
        const countEl = restoreBar.querySelector('[data-backup-count]');
        if (countEl) countEl.textContent = String(backup.length);
      } else {
        restoreBar.classList.add('hidden');
      }
    }

    const searchInput = document.getElementById('pins-search');
    const searchTerm = searchInput ? searchInput.value.toLowerCase() : '';

    const sortSelect = document.getElementById('pins-sort');
    const sortMode = sortSelect ? sortSelect.value : 'newest';

    // Filter pipeline: collection chip first, then search, then sort
    let filtered = applyCollectionFilter(pins, activeChip);

    if (searchTerm) {
      filtered = filtered.filter(p =>
        String(p.label || '').toLowerCase().includes(searchTerm) ||
        (p.note && String(p.note).toLowerCase().includes(searchTerm))
      );
    }

    let sorted = [...filtered];
    if (sortMode === 'newest') {
      sorted.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
    } else if (sortMode === 'oldest') {
      sorted.sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));
    } else if (sortMode === 'favorites') {
      sorted.sort((a, b) => (b.favorite ? 1 : 0) - (a.favorite ? 1 : 0) || new Date(b.createdAt) - new Date(a.createdAt));
    }

    grid.innerHTML = '';

    if (pins.length === 0) {
      empty.classList.remove('hidden');
      noResults.classList.add('hidden');
      return;
    }

    empty.classList.add('hidden');

    if (sorted.length === 0) {
      noResults.classList.remove('hidden');
      if (activeChip === 'sky-events') {
        noResults.innerHTML =
          'No Sky Events pins yet. <a href="' + base + 'sky-events" class="text-signal-400 hover:underline">Open Sky Events</a> and hit <strong>Pin this</strong> on Moon, Venus, or a constellation.';
      } else if (searchTerm) {
        noResults.textContent = 'No pins match your search.';
      } else if (activeChip === 'favorites') {
        noResults.textContent = 'No favorites yet — star a pin from All.';
      } else {
        noResults.textContent = 'No pins in this filter.';
      }
      return;
    }
    noResults.classList.add('hidden');
    noResults.textContent = 'No pins match your search.';

    // Rediscover strip — shown primarily when Quiet revisit chip is active (per handoff intent)
    const rediscover = document.getElementById('rediscover-strip');
    const rediscoverItems = document.getElementById('rediscover-items');

    if (activeChip === 'quiet') {
      const oldest = [...pins].sort((a, b) => new Date(a.updatedAt || a.createdAt) - new Date(b.updatedAt || b.createdAt)).slice(0, 3);

      if (oldest.length > 0) {
        rediscover.classList.remove('hidden');
        rediscoverItems.innerHTML = '';
        oldest.forEach(pin => {
          const el = document.createElement('div');
          el.className = 'px-3 py-1 rounded-lg border border-void-700 text-mist-300 hover:border-void-500 cursor-pointer text-sm';
          el.textContent = pin.label || 'Untitled';
          el.onclick = (e) => {
            // Light protection even though not inside main cards
            e.stopImmediatePropagation?.();
            localStorage.setItem('flyToPin', JSON.stringify(buildFlyToPayload(pin)));
            window.location.href = base + 'observatory';
          };
          rediscoverItems.appendChild(el);
        });
      } else {
        rediscover.classList.add('hidden');
      }
    } else {
      rediscover.classList.add('hidden');
    }

    sorted.forEach((pin) => {
      const card = document.createElement('div');
      const badge = pinSourceBadge(pin);
      const isFromSky = badge && badge.text === 'Sky Events';
      const isAtlas = badge && badge.text === 'Atlas';
      card.className = `group rounded-xl border border-void-700 bg-void-900 p-5 hover:border-void-500 hover:-translate-y-0.5 transition-all duration-200 shadow-sm cursor-pointer${isFromSky ? ' border-l-2 border-l-emerald-700' : ''}${isAtlas ? ' border-l-2 border-l-signal-600' : ''}`;

      // Thumbnail: only real data:image/* URLs. Bad/empty thumbs (broken P-capture, {}) → gradient.
      let thumbHTML = '';
      const viewState = pin.viewState || {};
      const sky = resolveSkyCoords(pin);
      const lat = safeNumber(viewState.lat, sky.hasSky ? sky.dec : 0);
      const lng = safeNumber(viewState.lng, sky.hasSky ? sky.ra : 0);
      const label = escapeHtml(pin.label || 'Untitled Pin');
      const note = pin.note ? escapeHtml(pin.note) : '';

      const hue = Math.floor(((lat + 90) / 180) * 360);
      const sat = 38 + Math.floor(Math.abs(lng) % 35);
      const light = 32 + Math.floor(Math.abs(lat) % 18);
      const gradientThumb = `<div class="pin-thumb-fallback" style="width:52px;height:38px;border-radius:6px;background:linear-gradient(135deg, hsl(${hue},${sat}%,${light}%), hsl(${hue+30},${sat+10}%,${light-8}%));flex-shrink:0;border:1px solid #36415a;"></div>`;
      const rawThumb = (typeof pin.thumbnailData === 'string') ? pin.thumbnailData : '';
      const hasRealThumb = rawThumb.indexOf('data:image/') === 0 && rawThumb.length > 64;

      if (hasRealThumb) {
        const fbStyle = `width:52px;height:38px;border-radius:6px;background:linear-gradient(135deg, hsl(${hue},${sat}%,${light}%), hsl(${hue+30},${sat+10}%,${light-8}%));flex-shrink:0;border:1px solid #36415a;`;
        thumbHTML = `<img src="${escapeHtml(rawThumb)}" alt="" class="pin-thumb w-[52px] h-[38px] rounded-md object-cover flex-shrink-0 border border-void-700" data-fallback="${escapeHtml(fbStyle)}" onerror="(function(img){var d=document.createElement('div');d.className='pin-thumb-fallback';d.style.cssText=img.getAttribute('data-fallback')||'';img.replaceWith(d);})(this)" />`;
      } else {
        thumbHTML = gradientThumb;
        // Scrub junk thumbnailData so it stops looking "broken" on every render
        if (pin.thumbnailData && !hasRealThumb) {
          pin.thumbnailData = '';
          try {
            const all = readPinsRaw();
            const cleaned = all.map((p) => (p && p.id === pin.id ? Object.assign({}, p, { thumbnailData: '' }) : p));
            safeWritePins(cleaned);
          } catch (e) {}
        }
      }

      const lastViewed = pin.updatedAt 
        ? `Last viewed ${Math.floor((Date.now() - new Date(pin.updatedAt).getTime()) / (1000*60*60*24))} days ago`
        : `Pinned ${new Date(pin.createdAt).toLocaleDateString()}`;

      let coordLine = '';
      if (sky.hasSky) {
        const fovBit = Number.isFinite(sky.fov) ? ` · FOV ${sky.fov < 10 ? sky.fov.toFixed(2) : sky.fov.toFixed(0)}°` : '';
        coordLine = `${degToHms(sky.ra)}  ${degToDms(sky.dec)}${fovBit}`;
      } else {
        coordLine = `lat ${lat.toFixed(2)} · lng ${lng.toFixed(2)}`;
      }

      const badgeHtml = badge
        ? `<span class="text-[10px] ${badge.cls}">${escapeHtml(badge.text)}</span>`
        : '';

      card.innerHTML = `
        <div class="flex justify-between items-start">
          <div class="flex items-center gap-2 min-w-0">
            ${thumbHTML}
            <div class="min-w-0">
              <div class="font-medium text-mist-100 pin-label cursor-pointer hover:underline flex items-center gap-1.5">
                ${label}
                ${pin.favorite ? `<span class="text-yellow-400 text-sm">★</span>` : ''}
              </div>
              <div class="text-[10px] text-mist-500 mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5">
                <span>${lastViewed}</span>
                ${badgeHtml}
              </div>
            </div>
          </div>
          <div class="flex items-center gap-1">
            <button class="edit-btn text-xs px-2 py-0.5 rounded border border-void-600 text-mist-400 hover:text-mist-200" data-id="${pin.id}">Edit</button>
            <button class="share-btn text-xs px-2 py-0.5 rounded border border-void-600 text-mist-400 hover:text-mist-200" data-id="${pin.id}">Share</button>
            <button class="favorite-btn text-lg leading-none transition-colors ${pin.favorite ? 'text-yellow-400' : 'text-mist-400 hover:text-yellow-300'}" data-id="${pin.id}">★</button>
            <button class="delete-pin text-mist-400 hover:text-red-400/80 text-xl leading-none transition-colors" data-id="${pin.id}">×</button>
          </div>
        </div>
        ${note ? `<div class="mt-3 text-sm text-mist-300 pin-note cursor-pointer hover:underline line-clamp-2">${note}</div>` : ''}
        <div class="mt-3 font-mono text-[10px] text-mist-500 tracking-wide">${escapeHtml(coordLine)}</div>
        <div class="edit-panel hidden mt-4 border-t border-void-700 pt-4"></div>
      `;

      // Click card → fly to Atlas. Never steal Edit focus (inputs / Save / Cancel).
      card.addEventListener('click', (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        if (
          t.closest('.edit-panel') ||
          t.closest('.edit-btn') ||
          t.closest('.delete-pin') ||
          t.closest('.favorite-btn') ||
          t.closest('.share-btn') ||
          t.tagName === 'INPUT' ||
          t.tagName === 'TEXTAREA' ||
          t.tagName === 'BUTTON' ||
          t.tagName === 'LABEL'
        ) {
          return;
        }

        localStorage.setItem('flyToPin', JSON.stringify(buildFlyToPayload(pin)));
        window.location.href = base + 'observatory';
      });

      // Delete
      card.querySelector('.delete-pin').addEventListener('click', (e) => {
        e.stopImmediatePropagation();
        if (!confirm('Remove this pin?')) return;
        const updated = pins.filter(p => p.id !== pin.id);
        safeWritePins(updated, { allowEmpty: true });
        renderMyPins();
      });

      // Favorite toggle
      const favBtn = card.querySelector('.favorite-btn');
      if (favBtn) {
        favBtn.addEventListener('click', (e) => {
          e.stopImmediatePropagation();
          pin.favorite = !pin.favorite;
          const updated = pins.map(p => p.id === pin.id ? pin : p);
          safeWritePins(updated);
          renderMyPins();
        });
      }

      // Share button (B.1) — direct like delete/favorite so it works on first click, no scope games
      const shareBtn = card.querySelector('.share-btn');
      if (shareBtn) {
        shareBtn.addEventListener('click', async (e) => {
          e.stopImmediatePropagation();
          try {
            const dataUrl = await createShareableImage(pin);
            const a = document.createElement('a');
            a.href = dataUrl;
            const safeLabel = (pin.label || 'Saved View').replace(/[^a-z0-9]/gi, '_');
            a.download = `dragon-lady-${safeLabel}.png`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
          } catch (err) {
            console.error('Share image failed', err);
            const toast = document.createElement('div');
            toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#0f1420;border:1px solid #5c3a3a;color:#e9edf5;padding:10px 22px;border-radius:9999px;font-size:13px;';
            toast.textContent = 'Could not generate share image.';
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 2800);
          }
        });
      }

      // Edit button opens inline panel
      const editBtn = card.querySelector('.edit-btn');
      const editPanel = card.querySelector('.edit-panel');

      editBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopImmediatePropagation();
        editPanel.innerHTML = `
          <div class="space-y-3">
            <input type="text" value="${escapeHtml(pin.label || '')}" class="edit-label w-full px-3 py-2 rounded-lg border border-void-700 bg-void-950 text-mist-100 text-sm" />
            <textarea class="edit-note w-full px-3 py-2 rounded-lg border border-void-700 bg-void-950 text-mist-100 text-sm" rows="3">${escapeHtml(pin.note || '')}</textarea>
            <div class="flex gap-2">
              <button type="button" class="save-edit px-4 py-1.5 text-sm rounded-lg bg-signal-400 text-void-950 font-medium">Save</button>
              <button type="button" class="cancel-edit px-4 py-1.5 text-sm rounded-lg border border-void-700 text-mist-300">Cancel</button>
            </div>
          </div>
        `;
        editPanel.classList.remove('hidden');
        // Keep all edit interactions on the card — do not bubble into fly-to-Aladin.
        editPanel.addEventListener('click', (ev) => ev.stopPropagation());
        editPanel.addEventListener('keydown', (ev) => ev.stopPropagation());

        const saveBtn = editPanel.querySelector('.save-edit');
        const cancelBtn = editPanel.querySelector('.cancel-edit');
        const labelInput = editPanel.querySelector('.edit-label');
        if (labelInput) setTimeout(() => labelInput.focus(), 0);

        saveBtn.addEventListener('click', (ev) => {
          ev.preventDefault();
          ev.stopImmediatePropagation();
          const newLabel = editPanel.querySelector('.edit-label').value.trim();
          const newNote = editPanel.querySelector('.edit-note').value.trim();
          if (newLabel) pin.label = newLabel;
          pin.note = newNote || undefined;
          const updated = pins.map(p => p.id === pin.id ? pin : p);
          safeWritePins(updated);
          renderMyPins();
        });

        cancelBtn.addEventListener('click', (ev) => {
          ev.preventDefault();
          ev.stopImmediatePropagation();
          editPanel.classList.add('hidden');
          editPanel.innerHTML = '';
        });
      });

      grid.appendChild(card);
    });
  }

  function updateChipVisuals() {
    const chips = document.querySelectorAll('#pins-chips .chip');
    chips.forEach(c => {
      const isActive = c.dataset.chip === activeChip;

      // Clear all state classes first
      c.classList.remove('active', 'border-signal-400', 'bg-void-800', 'text-mist-100', 'border-void-700', 'text-mist-300');

      if (isActive) {
        // Active appearance
        c.classList.add('active', 'border-signal-400', 'bg-void-800', 'text-mist-100');
      } else {
        // Inactive appearance
        c.classList.add('border-void-700', 'bg-void-900', 'text-mist-300');
      }
    });
  }

  function setupMyPins() {
    // Chip handling
    const chips = document.querySelectorAll('#pins-chips .chip');
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const chipType = chip.dataset.chip;

        if (activeChip === chipType) {
          activeChip = 'all';
        } else {
          activeChip = chipType;
        }

        updateChipVisuals();
        renderMyPins();
      });
    });

    // Export
    const exportBtn = document.getElementById('export-pins');
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        const pins = readPinsRaw();
        const date = new Date().toISOString().split('T')[0];
        const blob = new Blob([JSON.stringify(pins, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `dragon-lady-pins-${date}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // Restore from local backup
    const restoreBtn = document.getElementById('restore-pins-backup');
    if (restoreBtn) {
      restoreBtn.addEventListener('click', () => {
        const backup = readPinsBackup();
        if (!backup.length) {
          alert('No local backup found in this browser.');
          return;
        }
        if (!confirm('Restore ' + backup.length + ' pins from local backup?')) return;
        if (safeWritePins(backup)) {
          renderMyPins();
        }
      });
    }

    const seedBtn = document.getElementById('seed-known-pins');
    if (seedBtn) {
      seedBtn.addEventListener('click', () => {
        if (!confirm('Re-seed Hi 42 + mystery glow + HD 23514? This merges into an empty-ish shelf.')) return;
        const seeded = seedKnownSessionPinsIfEmpty([]);
        // Merge with anything currently present
        const current = readPinsRaw();
        const ids = new Set(current.map((p) => p && p.id));
        seeded.forEach((p) => {
          if (p && p.id && !ids.has(p.id)) current.push(p);
        });
        safeWritePins(current.length ? current : seeded);
        try { localStorage.setItem('dlo-m42-favorite-seeded', '1'); } catch (e) {}
        renderMyPins();
      });
    }

    // Import
    const importInput = document.getElementById('import-pins');
    if (importInput) {
      importInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (event) => {
          try {
            const imported = JSON.parse(event.target.result);
            if (!Array.isArray(imported)) {
              const toast = document.createElement('div');
              toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#0f1420;border:1px solid #5c3a3a;color:#e9edf5;padding:10px 22px;border-radius:9999px;font-size:13px;';
              toast.textContent = 'File does not contain a valid pins array.';
              document.body.appendChild(toast);
              setTimeout(() => toast.remove(), 3000);
              return;
            }

            let current = readPinsRaw();
            const existingIds = new Set(current.map(p => p.id));
            let added = 0;

            imported.forEach(pin => {
              if (pin && pin.id && !existingIds.has(pin.id)) {
                current.push(pin);
                existingIds.add(pin.id);
                added++;
              }
            });

            safeWritePins(current);
            renderMyPins();

            const msg = added === 1 ? '1 pin imported' : `${added} pins imported`;
            const toast = document.createElement('div');
            toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#0f1420;border:1px solid #36415a;color:#e9edf5;padding:10px 22px;border-radius:9999px;font-size:13px;';
            toast.textContent = msg;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);

          } catch (err) {
            const toast = document.createElement('div');
            toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#0f1420;border:1px solid #5c3a3a;color:#e9edf5;padding:10px 22px;border-radius:9999px;font-size:13px;';
            toast.textContent = 'Could not read the file. Please make sure it is a valid pins backup.';
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
          }
        };
        reader.readAsText(file);
        e.target.value = '';
      });
    }

    renderMyPins();
    updateChipVisuals();       // force correct initial highlighting
    const searchInput = document.getElementById('pins-search');
    const clearBtn = document.getElementById('clear-search');
    const sortSelect = document.getElementById('pins-sort');

    if (searchInput) {
      searchInput.addEventListener('input', () => renderMyPins());
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        renderMyPins();
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', () => renderMyPins());
    }
  }

  function setupSkyEventTiles() {
    const defaultViews = {
      moon: { lat: 18, lng: -35, altitude: 1.9 },
      'venus-evening': { lat: 8, lng: -65, altitude: 2.1 },
      perseids: { lat: 52, lng: 46, altitude: 2.0 },
      geminids: { lat: 33, lng: -15, altitude: 2.0 },
      orion: { lat: -8, lng: 84, altitude: 1.8 },
      pleiades: { lat: 24, lng: 58, altitude: 1.9 },
      andromeda: { lat: 41, lng: 10, altitude: 1.9 },
      cassiopeia: { lat: 62, lng: -15, altitude: 1.8 },
      'ursa-major': { lat: 55, lng: 20, altitude: 1.8 },
      scorpius: { lat: -25, lng: 100, altitude: 2.0 },
    };

    document.querySelectorAll('#sky-events-inline [data-sky-tile]').forEach(function (el) {
      const type = el.getAttribute('data-type');
      const id = el.getAttribute('data-id');
      const name = el.getAttribute('data-name');
      const desc = el.getAttribute('data-desc') || '';
      const sourceEventId = type + ':' + id;
      const btn = el.querySelector('.pin-btn');
      if (!btn) return;

      const pins = readPinsRaw();
      if (pins.some(function (p) { return p && p.sourceEventId === sourceEventId; })) {
        btn.textContent = 'Pinned ✓';
        btn.disabled = true;
        btn.classList.add('!border-emerald-700', '!text-emerald-400');
      }

      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopImmediatePropagation();
        const pinsNow = readPinsRaw();
        const existing = pinsNow.find(function (pin) { return pin && pin.sourceEventId === sourceEventId; });
        const pinId = existing ? existing.id : (Date.now().toString(36) + '-' + id);

        if (!existing) {
          pinsNow.unshift({
            id: pinId,
            createdAt: new Date().toISOString(),
            viewState: defaultViews[id] || { lat: 0, lng: 0, altitude: 2.4 },
            label: name,
            note: desc,
            sourceEventId: sourceEventId,
            source: 'sky-events',
          });
          safeWritePins(pinsNow);
        }

        btn.textContent = 'Pinned ✓';
        btn.disabled = true;
        btn.classList.add('!border-emerald-700', '!text-emerald-400');

        localStorage.setItem('flyToPin', JSON.stringify({
          id: pinId,
          label: name,
          viewState: defaultViews[id] || { lat: 0, lng: 0, altitude: 2.4 },
        }));

        renderMyPins();

        const toast = document.createElement('div');
        toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:3000;background:#0f1420;border:1px solid #36415a;color:#e9edf5;padding:10px 22px;border-radius:9999px;font-size:13px;display:flex;gap:12px;align-items:center;';
        toast.innerHTML = '<span>' + escapeHtml(name) + ' saved</span><a href="' + base + 'observatory" style="color:#6fd3e2;text-decoration:none;font-size:12px;">Open Atlas →</a>';
        document.body.appendChild(toast);
        setTimeout(function () { toast.remove(); }, 4200);
      });
    });
  }

  setupMyPins();
  setupSkyEventTiles();
  </script>
</Base>
