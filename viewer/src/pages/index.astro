    // Processes a loaded image (JPG or PNG) and returns a new Image with background cleaned.
    // - Removes near-white (for old JPGs)
    // - Removes common checkerboard grays (for user-provided transparent PNGs that have the editor's checkered bg baked or visible)
    // This ensures the handed images blend cleanly into the dark card with no checkered layer.
    // The actual art (dragon/lady) is preserved with contrast boost for faint use.
    async function processImageForTransparentBg(originalImg) {
      if (!originalImg || !originalImg.complete || originalImg.naturalWidth === 0) {
        return originalImg; // fallback to original if bad
      }
      return new Promise((resolve) => {
        const offCanvas = document.createElement('canvas');
        offCanvas.width = originalImg.naturalWidth || originalImg.width;
        offCanvas.height = originalImg.naturalHeight || originalImg.height;
        const offCtx = offCanvas.getContext('2d', { willReadFrequently: true });
        offCtx.drawImage(originalImg, 0, 0, offCanvas.width, offCanvas.height);

        const imageData = offCtx.getImageData(0, 0, offCanvas.width, offCanvas.height);
        const data = imageData.data;
        let transparentPixels = 0;
        for (let i = 3; i < data.length; i += 4) {
          if (data[i] < 250) transparentPixels += 1;
        }
        if (transparentPixels > data.length / 4 * 0.05) {
          resolve(originalImg);
          return;
        }

        const threshold = 240; // slightly less aggressive for mixed sources
        const softness = 20;

        for (let i = 0; i < data.length; i += 4) {
          const r = data[i];
          const g = data[i + 1];
          const b = data[i + 2];
          const avg = (r + g + b) / 3;

          const maxC = Math.max(r, g, b);
          const minC = Math.min(r, g, b);
          const isDesaturated = (maxC - minC) < 35; // grayish - broader to catch checkerboard in user PNGs

          if (isDesaturated && avg > 40 && avg < 250) {
            // checkerboard gray (common in transparent PNG previews/exports from GIMP etc.) -> fully transparent
            // this blends the "checked background" into the dark card
            data[i + 3] = 0;
          } else if (avg > threshold) {
            // very pure white bg -> transparent
            data[i + 3] = 0;
          } else if (avg > threshold - softness) {
            // soft edge fade for near-white
            const fade = Math.max(0, (avg - (threshold - softness)) / softness);
            data[i + 3] = Math.floor(data[i + 3] * (1 - fade));
          } else {
            // the mark area (the actual dragon/lady art): full opacity + stronger contrast boost.
            const boost = 0.72;
            let rr = Math.max(0, Math.min(255, Math.floor(r * boost)));
            let gg = Math.max(0, Math.min(255, Math.floor(g * boost)));
            let bb = Math.max(0, Math.min(255, Math.floor(b * boost)));
            const avgLine = (rr + gg + bb) / 3;
            if (avgLine < 180) {
              const extra = 0.88;
              rr = Math.max(0, Math.min(255, Math.floor(rr * extra)));
              gg = Math.max(0, Math.min(255, Math.floor(gg * extra)));
              bb = Math.max(0, Math.min(255, Math.floor(bb * extra)));
            }
            data[i] = rr;
            data[i + 1] = gg;
            data[i + 2] = bb;
            data[i + 3] = 255;
          }
        }

        offCtx.putImageData(imageData, 0, 0);

        const processed = new Image();
        processed.onload = () => resolve(processed);
        processed.onerror = () => resolve(originalImg); // fallback
        processed.src = offCanvas.toDataURL('image/png'); // use PNG for transparency
      });
    }

    async function softenPhotoWatermark(originalImg) {
      if (!originalImg || !originalImg.complete || originalImg.naturalWidth === 0) {
        return originalImg;
      }

      return new Promise((resolve) => {
        const offCanvas = document.createElement('canvas');
        offCanvas.width = originalImg.naturalWidth || originalImg.width;
        offCanvas.height = originalImg.naturalHeight || originalImg.height;
        const offCtx = offCanvas.getContext('2d', { willReadFrequently: true });
        offCtx.drawImage(originalImg, 0, 0, offCanvas.width, offCanvas.height);

        const imageData = offCtx.getImageData(0, 0, offCanvas.width, offCanvas.height);
        const data = imageData.data;
        const fade = Math.max(20, Math.floor(Math.min(offCanvas.width, offCanvas.height) * 0.18));

        for (let y = 0; y < offCanvas.height; y++) {
          for (let x = 0; x < offCanvas.width; x++) {
            const i = (y * offCanvas.width + x) * 4;
            const edgeDistance = Math.min(x, y, offCanvas.width - 1 - x, offCanvas.height - 1 - y);
            const edgeAlpha = Math.max(0, Math.min(1, edgeDistance / fade));
            data[i + 3] = Math.floor(data[i + 3] * edgeAlpha);
          }
        }

        offCtx.putImageData(imageData, 0, 0);

        const processed = new Image();
        processed.onload = () => resolve(processed);
        processed.onerror = () => resolve(originalImg);
        processed.src = offCanvas.toDataURL('image/png');
      });
    }

