---
import '@/styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = 'Real sky with Aladin — free glide and object search on real telescope survey imagery.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title ? `${title} · Dragon Lady Observatory` : 'Dragon Lady Observatory';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#05070d" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex min-h-[100dvh] flex-col">
    <!-- No sticky site chrome — page titles carry the home link. -->
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6"><slot /></main>
    <footer class="border-t border-void-800 bg-void-900 text-sm text-mist-400">
      <div class="mx-auto max-w-6xl px-4 py-5 space-y-1">
        <p>Observation and advisory only. Dragon Lady Observatory surfaces public space-domain data and flags anomalies; it does not act.</p>
        <p>Sources: Space-Track · CelesTrak · Launch Library 2 · NOAA SWPC · ESA NEOCC. Provenance shown on every record.</p>
        <p class="pt-1"><a href={base + 'about'} class="!text-mist-500 hover:!text-mist-300">About</a></p>
      </div>
    </footer>
  </body>
</html>
